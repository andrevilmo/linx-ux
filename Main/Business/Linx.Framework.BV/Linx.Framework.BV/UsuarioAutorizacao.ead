      <entityAdapterClientEvented>
        <entityAdapterHasEntityAdapterClientEvented Id="1e15e201-2078-4f70-98d8-2fee8f2f44ec">
          <entityAdapterClientEvent name="OnAdded" isStatic="false" canOverride="false" overloadName="OnAdded" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="@SetVisible(gbUserPasswordGroupBox;;!getAbsoluteValue(@Self().GeraSenhaUsuario));" />
        </entityAdapterHasEntityAdapterClientEvented>
        <entityAdapterHasEntityAdapterClientEvented Id="f74529dd-03e4-4b5f-8f6d-f9c1178d96c5">
          <entityAdapterClientEvent name="OnSaving" returnType="bool" isStatic="false" canOverride="false" overloadName="OnSaving" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="if (!vm.currentDataItem())&#xD;&#xA;&#x9;return true;&#xD;&#xA;&#xD;&#xA;var entity = @Self();&#x9;&#xD;&#xA;&#x9;&#xD;&#xA;//verifica email&#xD;&#xA;if (!(/^[a-zA-Z0-9][a-zA-Z0-9\._-]+@([a-zA-Z0-9\._-]+\.)[a-zA-Z-0-9]{2}/).test(getAbsoluteValue(entity.Email))){&#xD;&#xA;&#x9;@ShowAlert(&quot;Campo Email inválido !&quot;);&#xD;&#xA;&#x9;return false;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (! @IsAdded(entity))&#xA;     return true;&#xA;&#xA;            var geraSenha = !getAbsoluteValue(entity.AutenticacaoWindows) &amp;&amp; !getAbsoluteValue(entity.GeraSenhaUsuario);&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'CriaUsuario', (!getAbsoluteValue(entity.AutenticacaoWindows) &amp;&amp; getAbsoluteValue(entity.GeraSenhaUsuario)));&#xD;&#xA;&#xA;            if (geraSenha) {&#xA;                var confirmacao = getAbsoluteValue(entity.ConfirmacaoUsuario);&#xA;                var confirmacao1 = getAbsoluteValue(entity.ConfirmacaoUsuario1);&#xA;&#xA;                if (isNullOrEmpty(confirmacao) || isNullOrEmpty(confirmacao1)) {&#xA;                    @ShowAlert('Campos senha e confirmação devem ser informados.')&#xA;                    return false;&#xA;                }&#xA;&#xA;                var regularExpression = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&amp;])[A-Za-z\d@$!%*?&amp;]{7,50}$/;&#xD;&#xA;&#xD;&#xA;                if (!regularExpression.test(confirmacao)) {&#xD;&#xA;                    app.showMessage(('A senha deve conter no mínimo 7 e no máximo 50 caracteres, conter ao menos uma letra maiúscula, uma letra minúscula, um número e um caracter especial [!@#$%^&amp;*].').toString(), 'Alerta', ['Ok'])&#xD;&#xA;                    return false;&#xD;&#xA;                }&#xA;&#xA;                if (confirmacao != confirmacao1) {&#xA;                    @ShowAlert('Senha e confirmação inconsistentes.')&#xA;                    return false;&#xA;                }&#xA;       }" />
        </entityAdapterHasEntityAdapterClientEvented>
        <entityAdapterHasEntityAdapterClientEvented Id="a178e19e-ced0-480c-83be-26b68f8adf5d">
          <entityAdapterClientEvent name="OnPropertyChanged" parameters="string propertyName#object oldValue#object newValue" isStatic="false" canOverride="false" overloadName="OnPropertyChanged" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="if (propertyName == 'LxPfjFisicaJuridica'){&#xD;&#xA;&#x9;vm.UpdateMask()&#xD;&#xA;&#x9;return;&#xD;&#xA;}" />
        </entityAdapterHasEntityAdapterClientEvented>
      </entityAdapterClientEvented>
