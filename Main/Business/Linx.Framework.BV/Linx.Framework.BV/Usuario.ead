          <entityAdapterClientEvent name="BeforeGetLookUpTcsUsuarioRegraTransacaoQuery" returnType="string" isStatic="false" canOverride="false" overloadName="BeforeGetLookUpTcsUsuarioRegraTransacaoQuery" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="if (!vm.dataToolbar.canUndo()){&#xD;&#xA;&#x9;return;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;var modulos = &quot;&quot;;&#xD;&#xA;&#xD;&#xA;for (var i = 0; i &lt; vm.currentDataItem().TcsUsuarioRegraModuloList().length; i++) {&#xD;&#xA;&#x9;var item = vm.currentDataItem().TcsUsuarioRegraModuloList()[i];&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;modulos = modulos + (isNullOrEmpty(modulos) ? &quot;&quot; : &quot;,&quot;) + getAbsoluteValue(item.IdModulo);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;return &quot;IdUsuario#==#&quot; + vm.currentDataItem().IdUsuario() + (isNullOrEmpty(modulos) ? &quot;&quot; : &quot;;&amp;&amp;#IdModulo#In#&quot; + modulos);" />
