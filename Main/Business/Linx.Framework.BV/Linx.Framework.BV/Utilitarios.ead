      <entityAdapterClientEvented>
        <entityAdapterHasEntityAdapterClientEvented Id="57a635b5-5c7f-41e0-a767-ae7d1b4f2dc4">
          <entityAdapterClientEvent name="OnPropertyChanged" parameters="string propertyName#object oldValue#object newValue" isStatic="false" canOverride="false" overloadName="OnPropertyChanged" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="var entity = @Self();&#xD;&#xA;&#xD;&#xA;if (propertyName == &quot;Geral&quot;)&#xD;&#xA;{&#xD;&#xA;&#x9;if (newValue){&#xD;&#xA;&#x9;&#x9;if (getAbsoluteValue(entity.BandeiraRede)){&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'BandeiraRede', false);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;if (getAbsoluteValue(entity.Modulo)) {&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'Modulo', false);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;if (getAbsoluteValue(entity.Conexao)){&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'Conexao', false);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;if (getAbsoluteValue(entity.Relatorio)){&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'Relatorio', false);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;if (!isNullOrEmpty(getAbsoluteValue(entity.NomeUsuario))){&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'NomeUsuario', &quot;&quot;);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;if (!isNull(newValue)){&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;&#x9;var control = $lx(vm, '#ckBandeiraRede');&#xD;&#xA;&#x9;&#x9;if(control.length) {&#xD;&#xA;&#x9;&#x9;&#x9;control.attr(&quot;disabled&quot;, newValue);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;control = $lx(vm, '#ckModulo');&#xD;&#xA;&#x9;&#x9;if(control.length) {&#xD;&#xA;&#x9;&#x9;&#x9;control.attr(&quot;disabled&quot;, newValue);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;control = $lx(vm, '#ckConexao');&#xD;&#xA;&#x9;&#x9;if(control.length) {&#xD;&#xA;&#x9;&#x9;&#x9;control.attr(&quot;disabled&quot;, newValue);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;control = $lx(vm, '#ckRelatorio');&#xD;&#xA;&#x9;&#x9;if(control.length) {&#xD;&#xA;&#x9;&#x9;&#x9;control.attr(&quot;disabled&quot;, newValue);&#xD;&#xA;&#x9;&#x9;}&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;control = $lx(vm, '#lUpNomeUsuario_inputLookUp');&#xD;&#xA;&#x9;&#x9;if(control.length) {&#xD;&#xA;&#x9;&#x9;&#x9;control.attr(&quot;disabled&quot;, newValue);&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;control = $lx(vm, '#divNomeUsuario');&#xD;&#xA;&#x9;&#x9;if(control.length) {&#xD;&#xA;&#x9;&#x9;&#x9;var divName = &quot;block_&quot; + control.attr(&quot;id&quot;);&#xD;&#xA;&#x9;&#x9;&#x9;if (newValue){&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;$(control).append('&lt;div id=&quot;' + divName + '&quot; style=&quot;position: absolute;top:0;left:0;width: 100%;height:100%;z-index:2;opacity:0.4;filter: alpha(opacity = 50)&quot;&gt;&lt;/div&gt;');&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;else{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;$(control).children().remove(&quot;#&quot; + divName);&#xD;&#xA;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;}&#x9;&#x9;&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;" />
