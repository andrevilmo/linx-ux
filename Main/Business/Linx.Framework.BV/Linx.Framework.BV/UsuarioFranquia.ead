        <entityAdapterHasEntityAdapterClientEvented Id="ff8d3105-353a-40fd-acc0-51225c0c860c">
          <entityAdapterClientEvent name="OnAdded" isStatic="false" canOverride="false" overloadName="OnAdded" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="@SetVisible(gbUserPasswordGroupBox;;!getAbsoluteValue(@Self().GeraSenhaUsuario));" />
        </entityAdapterHasEntityAdapterClientEvented>
        <entityAdapterHasEntityAdapterClientEvented Id="478855fd-e0a1-414d-81e0-f78b6fa0075c">
          <entityAdapterClientEvent name="OnSaving" returnType="bool" isStatic="false" canOverride="false" overloadName="OnSaving" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="if (!vm.currentDataItem())&#xD;&#xA;&#x9;return true;&#xD;&#xA;&#xD;&#xA;var entity = @Self();&#x9;&#xD;&#xA;&#x9;&#xD;&#xA;//verifica email&#xD;&#xA;if (!(/^[a-zA-Z0-9][a-zA-Z0-9\._-]+@([a-zA-Z0-9\._-]+\.)[a-zA-Z-0-9]{2}/).test(getAbsoluteValue(entity.Email))){&#xD;&#xA;&#x9;@ShowAlert(&quot;Campo Email inválido !&quot;);&#xD;&#xA;&#x9;vm.showTab('tabUsuario');&#xD;&#xA;&#x9;return false;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (! @IsAdded(entity))&#xD;&#xA;     return true;&#xD;&#xA;&#xD;&#xA;            var geraSenha = !getAbsoluteValue(entity.AutenticacaoWindows) &amp;&amp; !getAbsoluteValue(entity.GeraSenhaUsuario);&#xD;&#xA;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'CriaUsuario', (!getAbsoluteValue(entity.AutenticacaoWindows) &amp;&amp; getAbsoluteValue(entity.GeraSenhaUsuario)));&#xD;&#xA;&#xD;&#xA;            if (geraSenha) {&#xD;&#xA;                var confirmacao = getAbsoluteValue(entity.ConfirmacaoUsuario);&#xD;&#xA;                var confirmacao1 = getAbsoluteValue(entity.ConfirmacaoUsuario1);&#xD;&#xA;&#xD;&#xA;                if (isNullOrEmpty(confirmacao) || isNullOrEmpty(confirmacao1)) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ShowAlert('Campos senha e confirmação devem ser informados.')&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;vm.showTab('tabUsuario');&#xD;&#xA;                    return false;&#xD;&#xA;                }&#xD;&#xA;&#xD;&#xA;                var regularExpression = /^(?=.*[0-9])(?=.*[!@#$%^&amp;*])[a-zA-Z0-9!@#$%^&amp;*]{6,16}$/;&#xD;&#xA;&#xD;&#xA;                if (!regularExpression.test(confirmacao)) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ShowAlert('A senha deve conter no mínimo 7 caracteres, sendo um deles um caracter especial [!@#$%^&amp;*].')&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;vm.showTab('tabUsuario');&#xD;&#xA;                    return false;&#xD;&#xA;                }&#xD;&#xA;&#xD;&#xA;                if (confirmacao != confirmacao1) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ShowAlert('Senha e confirmação inconsistentes.')&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;vm.showTab('tabUsuario');&#xD;&#xA;                    return false;&#xD;&#xA;                }&#xD;&#xA;       }" />
        </entityAdapterHasEntityAdapterClientEvented>
