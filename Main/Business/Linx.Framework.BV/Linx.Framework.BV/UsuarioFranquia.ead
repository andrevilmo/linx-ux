            <userInterfaceClientEvent name="OnDataGridCreated" parameters="string dataGridName" isStatic="false" canOverride="false" overloadName="OnDataGridCreated" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="var control = $lx(vm, '#' + dataGridName);&#xD;&#xA;&#xD;&#xA;if (dataGridName !== &quot;CadastroUsuarioLocal_dGridTcsUsuarioAutenticacaoAcesso&quot; || !control.length || !control.data('igGrid')){&#xD;&#xA;&#x9;return;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;var columns = control.igGrid(&quot;option&quot;, &quot;columns&quot;);&#xD;&#xA;&#x9;&#xD;&#xA;var gridColumn = $.grep(columns, function (element, index) { return element.key == 'Perfil' });&#xD;&#xA;&#xD;&#xA;if (gridColumn.count() &gt; 0) {&#xD;&#xA;&#x9;gridColumn[0].template = '&lt;button class=&quot;form-control btn-press ellipsis input-min-medium IsEditableStyle&quot;&gt;Perfil&lt;/button&gt;';&#xD;&#xA;&#x9;control.igGrid(&quot;option&quot;, &quot;columns&quot;, columns);&#xD;&#xA;&#x9;var columnSettings = control.igGridUpdating(&quot;option&quot;, &quot;columnSettings&quot;);&#xD;&#xA;&#x9;gridColumn = $.grep(columnSettings, function (element, index) { return element.columnKey == 'Perfil' });&#xD;&#xA;&#x9;if (gridColumn.count() &gt; 0){&#xD;&#xA;&#x9;&#x9;$(control).igGridUpdating(&quot;option&quot;, &quot;columnSettings&quot;, columnSettings);&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#x9;$(document).delegate(&quot;#CadastroUsuarioLocal_dGridTcsUsuarioAutenticacaoAcesso_container&quot;, &quot;iggridcellclick&quot;, function (evt, ui) {&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;if(ui.colKey !== 'Perfil' || @GetStatus() === &quot;C&quot;){&#xD;&#xA;&#x9;&#x9;&#x9;return;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;var idLinx = @GetValue(@TbCurrentData().currentTcsUsuarioAutenticacaoAcesso();;IdLinx);&#xD;&#xA;&#x9;&#x9;var idUsuario = @GetValue(@TbCurrentData().currentTcsUsuarioAutenticacaoAcesso();;IdUsuario);&#xD;&#xA;&#x9;&#x9;var nomeUsuario = @GetValue(@TbCurrentData().currentTcsUsuarioAutenticacaoAcesso();;NomeUsuario);&#xD;&#xA;&#x9;&#x9;var nomeEmpresa = @GetValue(@TbCurrentData().currentTcsUsuarioAutenticacaoAcesso();;NomeEmpresa);&#xD;&#xA;&#x9;&#x9;var removeDataToolbar = (@GetStatus() != &quot;Q&quot;);&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;@OpenUI(Perfil;;Linx.Framework.BV.SPA/CadastroUsuarioLocalPerfil;;{IdLinx:idLinx, IdUsuario:idUsuario};;{idLinx:idLinx,idUsuario:idUsuario,nomeUsuario:nomeUsuario,nomeEmpresa:nomeEmpresa,removeDataToolbar:removeDataToolbar,canAddNew:true,canClear:false,canCustomSearch:false,canDelete:true,canEdit:true,canLayout:false,canNavigate:false,canPrint:false,canSearch:false,noBusyLoading:false})&#xD;&#xA;&#x9;})&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;$(document).delegate(&quot;#CadastroUsuarioLocal_dGridTcsUsuarioAutenticacaoAcesso&quot;, &quot;iggridupdatingeditcellstarting&quot;, function (evt, ui) { &#xD;&#xA;    if (@GetStatus() === &quot;C&quot; || ui.columnKey !== &quot;DescricaoAmbienteRelacionado&quot;){&#xD;&#xA;&#x9;&#x9;return true;&#xD;&#xA;&#x9;}&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;return @GetValue(@TbCurrentData().currentTcsUsuarioAutenticacaoAcesso();;IdTcsAplicativo) === 3;&#xD;&#xA;&#x9;&#xD;&#xA;});&#xD;&#xA;" exposedByViewModel="true" />
