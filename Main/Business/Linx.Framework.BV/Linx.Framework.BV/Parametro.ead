            <userInterfaceClientEvent name="OnLoaded" isStatic="false" canOverride="false" overloadName="OnLoaded" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="vm.showProcessing('Verificando nível de acesso...');&#xD;&#xA;&#xD;&#xA;@SetSharedData('NIVELACESSOPARAMETRO';;0)&#xD;&#xA;&#xD;&#xA;$.ajax({&#xD;&#xA;&#x9;&#x9;&#x9;type: 'GET',&#xD;&#xA;            message: &quot;Verificando nível de acesso...&quot;,&#xD;&#xA;            messageUser: &quot;Verificando nível de acesso...&quot;,&#xD;&#xA;            globalError: true,&#xD;&#xA;&#x9;&#x9;&#x9;headers: managerAuth.getHeaders(),&#xD;&#xA;            url: managerAuth.getServiceAddress('LinxFrameworkParametro') + '/GetParameterValue?serializedParameterList=NIVEL_ACESSO_PARAMETRO{TCS_USUARIO|' + managerAuth.loginInfo.UidUsuario + '}' ,&#xD;&#xA;            dataType: 'json',&#xD;&#xA;            cache: false,&#xD;&#xA;            error: function (jqXHR, textStatus, errorThrown) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;                    },&#xD;&#xA;&#x9;&#x9;&#x9;success: function (data) {&#xD;&#xA;                        var parameters = data.split('|');&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if (parameters.count() == 2){&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@SetSharedData('NIVELACESSOPARAMETRO';;parseInt(parameters[1]))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AdjustControls();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;                    }&#xD;&#xA;                });&#xD;&#xA;" exposedByViewModel="false" />
