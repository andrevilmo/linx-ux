            <userInterfaceClientEvent name="OnSaved" parameters="object[] changes" isStatic="false" canOverride="false" overloadName="OnSaved" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="AdjustValorPadrao();&#xD;&#xA;//Força o refresh para resolver problema de não excluir a filha&#xD;&#xA;//quando inclui -&gt; salva -&gt; altera -&gt; exclui&#xD;&#xA;//o registro some da UI mas não é removido da base de dados&#xD;&#xA;refreshCurrentData();" exposedByViewModel="false" />
