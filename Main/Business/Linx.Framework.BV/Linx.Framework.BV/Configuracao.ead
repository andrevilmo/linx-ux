ity, 'DescricaoAmbiente', data[i].DescricaoAmbiente);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'DescricaoAplicacao', data[i].DescricaoAplicacao);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'DescricaoAplicativo', data[i].DescricaoAplicativo);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IdAplicacao', data[i].IdAplicacao);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'UidAplicacao', data[i].UidAplicacao);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IdLinx', data[i].IdLinx);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IdTcsAmbiente', data[i].IdTcsAmbiente);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IdTcsAplicativo', data[i].IdTcsAplicativo);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IdTcsUsuarioAcesso', data[i].IdTcsUsuarioAcesso);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IdUsuario', data[i].IdUsuario);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IndicaAcessoPadrao', data[i].IndicaAcessoPadrao);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IndicaAdministrador', data[i].IndicaAdministrador);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'IndicaMultiGpecon', data[i].IndicaMultiGpecon);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'NomeEmpresa', data[i].NomeEmpresa);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'UidEmpresa', data[i].UidEmpresa);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;setAbsoluteValue(entity, 'Selecionado', true);&#xD;&#xA;                        }&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@NotifyAll();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;                    }&#xD;&#xA;           });&#xD;&#xA;&#xD;&#xA;}" />
