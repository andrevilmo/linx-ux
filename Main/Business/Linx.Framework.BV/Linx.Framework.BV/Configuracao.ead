#x9;&#x9;&#x9;&#x9;type: 'POST',&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;message: &quot;Gerando configuração inicial.&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;messageUser: &quot;Gerando configuração inicial.&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;globalError: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;headers: managerAuth.getHeaders(),&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;url: managerAuth.getServiceAddress('LinxFrameworkConfiguracao', 'Linx.Framework.Bv') + '/CriaConfiguracaoInicial' ,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;data:  JSON.stringify(acesso) ,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;contentType: 'application/json',&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;async: true,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;cache: false,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;error: function (jqXHR, textStatus, errorThrown) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;},&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;success: function (data) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ShowInformation(&quot;Processo finalizado com sucesso.&quot;);&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;});&#x9;  &#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;  })" exposedByViewModel="true" />
