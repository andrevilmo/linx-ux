          <entityAdapterUserInterfaceHasUserInterfaceClientEvented Id="98e1dd52-d504-4b61-ba06-6472626cad3d">
            <userInterfaceClientEvent name="OnLoaded" isStatic="false" canOverride="false" overloadName="OnLoaded" isUniqueOverload="true" isShared="false" isPartial="false" macroScript="      var botaoUrlSuporte = function () {&#xD;&#xA;&#xD;&#xA;            var btn = {&#xD;&#xA;                id: &quot;CadastroAmbiente_btnUrlSuporte&quot;,&#xD;&#xA;                grid: &quot;TcsAmbienteUsuarioAcesso&quot;,&#xD;&#xA;                title: &quot;Gerar Url para Suporte&quot;,&#xD;&#xA;                text: &quot;Gerar Url para Suporte&quot;,&#xD;&#xA;                visibleStatus: managerAuth.isShellProdMode ? &quot;Q&quot; : &quot;X&quot;,&#xD;&#xA;                click: function (viewModel, btn) {&#xD;&#xA;                    var item = vm.currentDataItem().currentTcsAmbienteUsuarioAcesso();&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;vm.showProcessing('Requisitando Url para suporte...');&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;                    $.ajax({&#xD;&#xA;                        type: 'POST',&#xD;&#xA;                        globalError: true,&#xD;&#xA;                        message: &quot;Requisitando Url para suporte&quot;,&#xD;&#xA;                        messageUser: &quot;Requisitando Url para suporte&quot;,&#xD;&#xA;                        headers: managerAuth.getHeaders(),&#xD;&#xA;                        url: managerAuth.getServiceAddress('LinxFrameworkUsuarioAutorizacao', 'Linx.Framework.BV') + '/SupportRequest',&#xD;&#xA;                        data: JSON.stringify({&#xD;&#xA;                            UidUsuario: item.UidUsuario,&#xD;&#xA;                            IdTcsAmbiente: item.IdTcsAmbiente,&#xD;&#xA;                            UrlPortal: managerAuth.loginUrl&#xD;&#xA;                        }),&#xD;&#xA;                        contentType: &quot;application/json&quot;,&#xD;&#xA;                        async: true,&#xD;&#xA;                        cache: false,&#xD;&#xA;&#xD;&#xA;                        error: function (jqXHR, textStatus, errorThrown) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;                        },&#xD;&#xA;&#xD;&#xA;                        success: function (data) {&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;vm.closeProcessing();&#xD;&#xA;                            require(['viewmodels/shared/modalSupportRequestUrl'], function (modalSupportRequest) {&#xD;&#xA;                                modalSupportRequest.show(data);&#xD;&#xA;                            });&#xD;&#xA;                        }&#xD;&#xA;                    });&#xD;&#xA;&#xD;&#xA;                }&#xD;&#xA;            };&#xD;&#xA;&#xD;&#xA;            if ($lx(vm,&quot;#&quot; + btn.id).length == 0) {&#xD;&#xA;                btn.id = btn.id || &quot;&quot;;&#xD;&#xA;                btn.title = btn.title || &quot;&quot;;&#xD;&#xA;                btn.text = btn.text || &quot;&quot;;&#xD;&#xA;                btn.icon = btn.icon || &quot;&quot;;&#xD;&#xA;                btn.type = btn.type || &quot;default&quot;;&#xD;&#xA;                btn.visibleStatus = btn.visibleStatus || [&quot;Q&quot;];&#xD;&#xA;&#xD;&#xA;                btn.element = $('&lt;button class=&quot;btn default background-color-theme&quot; id=&quot;' + btn.id + '&quot; title=&quot;' + btn.title + '&quot;&gt;&lt;i class=&quot;fa fa-cogs&quot;&gt;&lt;/i&gt;&lt;/button&gt;');&#xD;&#xA;&#xD;&#xA;                if ($.inArray(vm.status(), btn.visibleStatus) &gt;= 0) {&#xD;&#xA;                    btn.element.show();&#xD;&#xA;                }&#xD;&#xA;                else {&#xD;&#xA;                    btn.element.hide();&#xD;&#xA;                }&#xD;&#xA;&#xD;&#xA;                vm.status.subscribe(function (newValue) {&#xD;&#xA;                    if ($.inArray(newValue, btn.visibleStatus) &gt;= 0) {&#xD;&#xA;                        btn.element.show();&#xD;&#xA;                    }&#xD;&#xA;                    else {&#xD;&#xA;                        btn.element.hide();&#xD;&#xA;                    }&#xD;&#xA;                });&#xD;&#xA;&#xD;&#xA;                $lx(vm, '#btnUrlSuporte:not(.bound)').addClass('bound').addClass('btn').addClass('tooltips').css('margin-top', '14px').css('font-size', '14px').removeClass('form-control').html('&lt;i class=&quot;icon-plus&quot;&gt;&lt;/i&gt; Incluir').parents('.controls').removeClass('controls input-icon');&#xD;&#xA;&#xD;&#xA;                btn.element.insertAfter($lx(vm, '#dGrid' + btn.grid + '_AddBtn'));&#xD;&#xA;&#xD;&#xA;                $lx(vm,&quot;#&quot; + btn.id).on('click', function (evt) {&#xD;&#xA;                    btn.click(vm, btn);&#xD;&#xA;                });&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        botaoUrlSuporte();&#xD;&#xA;&#xD;&#xA;        vm.currentDataItem.subscribe(function (newValue) {&#xD;&#xA;            botaoUrlSuporte();&#xD;&#xA;        });" exposedByViewModel="false" />
          </entityAdapterUserInterfaceHasUserInterfaceClientEvented>
