<Window x:Class="TelerikReport.Publish.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="532.894" Width="947.368" Loaded="Window_Loaded" 
        ResizeMode="NoResize">
    <Grid>
        <Grid HorizontalAlignment="Left" Height="416" Margin="10,10,0,0" VerticalAlignment="Top" Width="919">
            <ListView SelectionMode="Multiple" ItemsSource="{Binding}" Name="lbxResourcesOprions" HorizontalAlignment="Left" Height="293" Margin="10,113,0,0" VerticalAlignment="Top" Width="329">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListView>
            <ListView SelectionMode="Multiple" ItemsSource="{Binding}" x:Name="lbxResourcesSelected" HorizontalAlignment="Left" Height="293" Margin="580,113,0,0" VerticalAlignment="Top" Width="329">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListView>
            <Button Content="&gt;" Name="btnAdd" HorizontalAlignment="Left" Margin="443,165,0,0" VerticalAlignment="Top" Width="39" Click="btnAdd_Click"/>
            <Button Content="&lt;" Name="btnRemove" HorizontalAlignment="Left" Margin="443,303,0,0" VerticalAlignment="Top" Width="39" Click="btnRemove_Click"/>
            <Rectangle Fill="#FFF4F4F5" HorizontalAlignment="Left" Height="62" Margin="10,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="899"/>
            <TextBox HorizontalAlignment="Left"
                     Text="C:\Program Files (x86)\Telerik\Reporting Q1 2015\Report Designer\Linx Reports"
                     Name="txtSelectedFolder" Height="26" Margin="30,28,0,362" TextWrapping="Wrap" VerticalAlignment="Center" Width="708" GotFocus="txtSelectedFolder_GotFocus" />
            <Button Name="btnSelectFolder" Content="Pasta" HorizontalAlignment="Left" Margin="754,27,0,0" VerticalAlignment="Top" Width="144" Height="27" Click="btnSelectFolder_Click"/>
        </Grid>
        <Button Content="Publicar" Name="btnPublish" HorizontalAlignment="Left" Margin="778,449,0,0" VerticalAlignment="Top" Width="139" Height="27" Click="btnPublish_Click"/>
        <CheckBox Content="Publicar em ambiente de desenvolvimento?" Name="cbxDevPublish" HorizontalAlignment="Left" Margin="23,456,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>

    