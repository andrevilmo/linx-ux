<style type="text/css">
	.footer {
		background-color: #333 !important;
		color: #fff !important;
		z-index: 2147483000 !important;
		position: fixed !important;
		bottom: 0 !important;
		left: 0 !important;
		right: 0 !important;
		width: 100% !important;
		min-height: 36px !important;
		height: 36px !important;
		padding: 8px 20px !important;
		margin: 0 !important;
		display: block !important;
		visibility: visible !important;
		opacity: 1 !important;
		overflow: visible !important;
		box-sizing: border-box !important;
		line-height: 20px !important;
		font-size: 12px !important;
	}
	.footer .logo-footer,
	.footer a.logo-footer,
	.footer .footer-inner {
		display: inline-block !important;
		float: none !important;
		color: #fff !important;
		font-weight: lighter !important;
		vertical-align: middle !important;
		line-height: 20px !important;
	}
	.footer .logo-footer,
	.footer a.logo-footer {
		margin-right: 8px !important;
	}
</style>
<div class="footer">
	<a class="dropdown-toggle topmenulink logo-footer" href="#">
		<img alt="logo" class="img-responsive-footer" src="@Url.ContentWithModuleId("~/lib/linx/img/favicon-16x16.png")"/>
	</a>
	<div class="footer-inner">
		&copy; @System.DateTime.Now.Year.ToString() Linx - Todos direitos reservados. [@BaseHelpers.NumeroVersao :: @BaseHelpers.DataVersao.ToString("dd/MM/yyyy HH:mm")]
	</div>
</div>
