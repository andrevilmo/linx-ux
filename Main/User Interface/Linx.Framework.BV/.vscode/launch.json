{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build (Linx.Framework.BV)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/build-runner.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Deploy (Linx.Framework.BV)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/deploy-runner.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Publish (Linx.Framework.BV)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/publish-runner.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
