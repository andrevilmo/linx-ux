<?xml version="1.0" encoding="utf-8"?>
<xsd:schema id="BusinessDataModelDesignerSchema" targetNamespace="http://schemas.microsoft.com/dsltools/BusinessDataModelDesigner" elementFormDefault="qualified" xmlns="http://schemas.microsoft.com/dsltools/BusinessDataModelDesigner" xmlns:core="http://schemas.microsoft.com/VisualStudio/2008/DslTools/Core" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:import id="CoreSchema" namespace="http://schemas.microsoft.com/VisualStudio/2008/DslTools/Core" />
  <!-- NamedElement -->
  <xsd:element name="namedElement" abstract="true" type="NamedElement" substitutionGroup="core:modelElement" />
  <xsd:complexType name="NamedElement" abstract="true" >
    <xsd:complexContent>
      <xsd:extension base="core:ModelElement">
        <!-- Id -->
        <xsd:attribute name="Id" type="xsd:string">
          <xsd:annotation>
            <xsd:documentation>Instance Guid of this element, needed because SerializeId is set to true.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Name -->
        <xsd:attribute name="name" type="xsd:string" use="required" />
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <!-- NamedElement Moniker -->
  <xsd:element name="namedElementMoniker" abstract="true" type="NamedElementMoniker" substitutionGroup="core:modelElementMoniker" />
  <xsd:complexType name="NamedElementMoniker">
    <xsd:annotation>
      <xsd:documentation>Moniker for NamedElement instance.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="core:ModelElementMoniker">
        <xsd:attribute name="name" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Attribute to store the moniker string.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <!-- BusinessDataModelDesignerRoot -->
  <xsd:element name="businessModelDesignerRoot" type="BusinessDataModelDesignerRoot" substitutionGroup="namedElement" />
  <xsd:complexType name="BusinessDataModelDesignerRoot">
    <xsd:complexContent>
      <xsd:extension base="NamedElement">
        <xsd:sequence minOccurs="0" maxOccurs="1">
          <!-- Relationship: BusinessDataModelDesignerRootHasComments -->
          <xsd:element name="comments" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of BusinessDataModelDesignerRootHasComments</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:choice minOccurs="0" maxOccurs="unbounded" >
                  <xsd:element ref="businessModelDesignerRootHasComments">
                    <xsd:annotation>
                      <xsd:documentation>[Relationship deriving from BusinessDataModelDesignerRootHasComments needs to be serialized in full-form]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                  <xsd:element ref="comment" >
                    <xsd:annotation>
                      <xsd:documentation>[Target role-player]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                </xsd:choice>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: BusinessDataModelDesignerRootHasTypes -->
          <xsd:element name="types" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of BusinessDataModelDesignerRootHasTypes</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:choice minOccurs="0" maxOccurs="unbounded" >
                  <xsd:element ref="businessModelDesignerRootHasTypes">
                    <xsd:annotation>
                      <xsd:documentation>[Relationship deriving from BusinessDataModelDesignerRootHasTypes needs to be serialized in full-form]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                  <xsd:element ref="modelType" >
                    <xsd:annotation>
                      <xsd:documentation>[Target role-player]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                </xsd:choice>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: BusinessDataModelDesignerRootHasStoreScripts -->
          <xsd:element name="storeScripts" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of BusinessDataModelDesignerRootHasStoreScripts</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="businessModelDesignerRootHasStoreScripts" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of BusinessDataModelDesignerRootHasStoreScripts needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: BusinessDataModelDesignerRootHasDbProviders -->
          <xsd:element name="dbProviders" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of BusinessDataModelDesignerRootHasDbProviders</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="businessModelDesignerRootHasDbProviders" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of BusinessDataModelDesignerRootHasDbProviders needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: BusinessDataModelDesignerRootHasModelImplementations -->
          <xsd:element name="modelImplementations" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of BusinessDataModelDesignerRootHasModelImplementations</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="businessModelDesignerRootHasModelImplementations" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of BusinessDataModelDesignerRootHasModelImplementations needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: BusinessDataModelDesignerRootHasWebApiControllers -->
          <xsd:element name="webApiControllers" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of BusinessDataModelDesignerRootHasWebApiControllers</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="businessModelDesignerRootHasWebApiControllers" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of BusinessDataModelDesignerRootHasWebApiControllers needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
        </xsd:sequence>
        <!-- Id -->
        <xsd:attribute name="Id" type="xsd:string">
          <xsd:annotation>
            <xsd:documentation>Instance Guid of this element, needed because SerializeId is set to true.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- dslVersion -->
        <xsd:attribute name="dslVersion" type="xsd:string">
          <xsd:annotation>
            <xsd:documentation>Version of the model serialized in this file.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DocumentName -->
        <xsd:attribute name="documentName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Document file name</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: TargetNamespace -->
        <xsd:attribute name="targetNamespace" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>The target namespace for the solution.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DocumentPath -->
        <xsd:attribute name="documentPath" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Diagram Document Path</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: NoCode -->
        <xsd:attribute name="noCode" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>If this property is true, this designer does not generate code.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DataContextName -->
        <xsd:attribute name="dataContextName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Container name for all entities.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: RemoveAutomaticIndexes -->
        <xsd:attribute name="removeAutomaticIndexes" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Do not generate all foreign keys indexes.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: RemoveRequiredAttributes -->
        <xsd:attribute name="removeRequiredAttributes" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Do not generate the required attributes on the properties.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: BusinessGroupForFilteringOfDimension -->
        <xsd:attribute name="businessGroupForFilteringOfDimension" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>This is the business group name for separating dimension filters (e.g.: Sales).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableAutomaticAuthorization -->
        <xsd:attribute name="enableAutomaticAuthorization" type="xsd:boolean" />
        <!-- Property: EnableAccessConnectionControl -->
        <xsd:attribute name="enableAccessConnectionControl" type="xsd:boolean" />
        <!-- Property: EnableViewCacheFactory -->
        <xsd:attribute name="enableViewCacheFactory" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable PreGeneratedViews mechanism.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: SetIdLinxWithIdGpecon -->
        <xsd:attribute name="setIdLinxWithIdGpecon" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>If this value is true, configure always ID_LINX == ID_GPECON</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ForceDynamicForeignKeyNames -->
        <xsd:attribute name="forceDynamicForeignKeyNames" type="xsd:boolean" />
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <!-- BusinessDataModelDesignerRoot Moniker -->
  <xsd:element name="businessModelDesignerRootMoniker" type="BusinessDataModelDesignerRootMoniker" substitutionGroup="namedElementMoniker" />
  <xsd:complexType name="BusinessDataModelDesignerRootMoniker">
    <xsd:annotation>
      <xsd:documentation>Moniker for BusinessDataModelDesignerRoot instance.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NamedElementMoniker">
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <!-- ModelClass -->
  <xsd:element name="modelClass" type="ModelClass" substitutionGroup="modelType" />
  <xsd:complexType name="ModelClass">
    <xsd:complexContent>
      <xsd:extension base="ModelType">
        <xsd:sequence minOccurs="0" maxOccurs="1">
          <!-- Relationship: ClassHasAttributes -->
          <xsd:element name="attributes" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of ClassHasAttributes</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:choice minOccurs="0" maxOccurs="unbounded" >
                  <xsd:element ref="classHasAttributes">
                    <xsd:annotation>
                      <xsd:documentation>[Relationship deriving from ClassHasAttributes needs to be serialized in full-form]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                  <xsd:element ref="modelAttribute" >
                    <xsd:annotation>
                      <xsd:documentation>[Target role-player]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                </xsd:choice>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: ClassHasOperations -->
          <xsd:element name="operations" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of ClassHasOperations</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:choice minOccurs="0" maxOccurs="unbounded" >
                  <xsd:element ref="classHasOperations">
                    <xsd:annotation>
                      <xsd:documentation>[Relationship deriving from ClassHasOperations needs to be serialized in full-form]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                  <xsd:element ref="classOperation" >
                    <xsd:annotation>
                      <xsd:documentation>[Target role-player]</xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                </xsd:choice>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: Generalization -->
          <xsd:element name="subclasses" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of Generalization</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="generalization" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of Generalization needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: ClassHasIndexes -->
          <xsd:element name="modelIndexes" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of ClassHasIndexes</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="classHasIndexes" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of ClassHasIndexes needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: Association -->
          <xsd:element name="targetModelClasses" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of Association</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="association" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of Association needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: GeneralizationSh -->
          <xsd:element name="subclassesSh" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of GeneralizationSh</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="generalizationSh" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of GeneralizationSh needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: ClassHasDataRoutes -->
          <xsd:element name="routeMapDatum" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of ClassHasDataRoutes</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="classHasDataRoutes" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of ClassHasDataRoutes needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <!-- Relationship: ModelViewAssociation -->
          <xsd:element name="modelViews" minOccurs="0" maxOccurs="1">
            <xsd:annotation>
              <xsd:documentation>Instances of ModelViewAssociation</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element ref="modelViewAssociation" minOccurs="0" maxOccurs="unbounded">
                  <xsd:annotation>
                    <xsd:documentation>[Instance of ModelViewAssociation needs to be serialized in full-form]</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
        </xsd:sequence>
        <!-- Id -->
        <xsd:attribute name="Id" type="xsd:string">
          <xsd:annotation>
            <xsd:documentation>Instance Guid of this element, needed because SerializeId is set to true.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Kind -->
        <xsd:attribute name="kind" type="ClassKind" >
          <xsd:annotation>
            <xsd:documentation>Type of main structure of this class.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Modifier -->
        <xsd:attribute name="modifier" type="InheritanceModifier" />
        <!-- Property: Table -->
        <xsd:attribute name="table" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Database table name</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Schema -->
        <xsd:attribute name="schema" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Database schema name</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: PrimaryKeyConstraintName -->
        <xsd:attribute name="primaryKeyConstraintName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Primary Key Constraint Name</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DisplayName -->
        <xsd:attribute name="displayName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>The display name information.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: NotMapped -->
        <xsd:attribute name="notMapped" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Not mapped witht the database.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: CustomAttributes -->
        <xsd:attribute name="customAttributes" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Custom attribute definitions. All attribute definitions must be separated per #.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: HideAssociations -->
        <xsd:attribute name="hideAssociations" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Hide all associations connected with this object.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsClustered -->
        <xsd:attribute name="isClustered" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>The primary key index is clustered.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsFactTable -->
        <xsd:attribute name="isFactTable" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable this entity for filtering of related dimensions.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsDimensionFilter -->
        <xsd:attribute name="isDimensionFilter" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>This information is a dimension used exclusively for filtering.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ContentDefinition -->
        <xsd:attribute name="contentDefinition" type="xsd:string" />
        <!-- Property: PrimaryKeyColumnMap -->
        <xsd:attribute name="primaryKeyColumnMap" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Column name for inherited primary key.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsReadOnly -->
        <xsd:attribute name="isReadOnly" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>This entity is read only, that is, it does not support crud operations.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: InStudy -->
        <xsd:attribute name="inStudy" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>This property alerts that this class is in study mode.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableIdLinxForSearching -->
        <xsd:attribute name="enableIdLinxForSearching" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable control of internal business rules for IdLinx.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableIdGpeconForSearching -->
        <xsd:attribute name="enableIdGpeconForSearching" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable control of internal business rules for IdGpecon.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableIdLinxForInserting -->
        <xsd:attribute name="enableIdLinxForInserting" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable control of internal business rules for IdLinx.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableIdGpeconForInserting -->
        <xsd:attribute name="enableIdGpeconForInserting" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable control of internal business rules for IdGpecon.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsValidatable -->
        <xsd:attribute name="isValidatable" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable validation on saving  for this entity.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewDefinition -->
        <xsd:attribute name="modelViewDefinition" type="xsd:string" />
        <!-- Property: ModelViewAggregation -->
        <xsd:attribute name="modelViewAggregation" type="xsd:boolean" />
        <!-- Property: ModelViewMainEntity -->
        <xsd:attribute name="modelViewMainEntity" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>The main entity of the query definition.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewDbSets -->
        <xsd:attribute name="modelViewDbSets" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>All inner entities for CRUD.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableCache -->
        <xsd:attribute name="enableCache" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable caching of second level.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Filter -->
        <xsd:attribute name="filter" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Example: (this.ViewFieldName1 = &apos;AAXX&apos; || this.ViewFieldName2 &gt; 20)</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewDistinct -->
        <xsd:attribute name="modelViewDistinct" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Execute distinct command over the  model view select command.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewTop -->
        <xsd:attribute name="modelViewTop" type="xsd:integer" />
        <!-- Property: ModelViewCodePreQuery -->
        <xsd:attribute name="modelViewCodePreQuery" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Code for creating resources before the query execution.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: EnableIdFilialPfjControl -->
        <xsd:attribute name="enableIdFilialPfjControl" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Enable automatic search control for ID_FILIAL_PFJ.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <!-- ModelClass Moniker -->
  <xsd:element name="modelClassMoniker" type="ModelClassMoniker" substitutionGroup="modelTypeMoniker" />
  <xsd:complexType name="ModelClassMoniker">
    <xsd:annotation>
      <xsd:documentation>Moniker for ModelClass instance.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ModelTypeMoniker">
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <!-- ModelAttribute -->
  <xsd:element name="modelAttribute" type="ModelAttribute" substitutionGroup="classModelElement" />
  <xsd:complexType name="ModelAttribute">
    <xsd:annotation>
      <xsd:documentation>An attribute of a class.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ClassModelElement">
        <!-- Id -->
        <xsd:attribute name="Id" type="xsd:string">
          <xsd:annotation>
            <xsd:documentation>Instance Guid of this element, needed because SerializeId is set to true.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DataType -->
        <xsd:attribute name="dataType" type="ModelDataType" />
        <!-- Property: DefaultValue -->
        <xsd:attribute name="defaultValue" type="xsd:string" />
        <!-- Property: ColumnName -->
        <xsd:attribute name="columnName" type="xsd:string" />
        <!-- Property: IsPrimaryKey -->
        <xsd:attribute name="isPrimaryKey" type="xsd:boolean" />
        <!-- Property: IsIdentity -->
        <xsd:attribute name="isIdentity" type="xsd:boolean" />
        <!-- Property: IsNullable -->
        <xsd:attribute name="isNullable" type="xsd:boolean" />
        <!-- Property: Precision -->
        <xsd:attribute name="precision" type="xsd:string" />
        <!-- Property: Scale -->
        <xsd:attribute name="scale" type="xsd:string" />
        <!-- Property: DisplayName -->
        <xsd:attribute name="displayName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>The display name information.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: CustomAttributes -->
        <xsd:attribute name="customAttributes" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Custom attribute definitions. All attribute definitions must be separated per #.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Range -->
        <xsd:attribute name="range" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>The values range for validation (eg: 1, 7).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DataFormatString -->
        <xsd:attribute name="dataFormatString" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Data Format (Ex: C02, N02, d)</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DomainName -->
        <xsd:attribute name="domainName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Domain view name.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Mask -->
        <xsd:attribute name="mask" type="xsd:string" />
        <!-- Property: Formula -->
        <xsd:attribute name="formula" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Code that returns the formula value. You can use the following macros:@Iif(MacroCondition;;TrueMacroExpression;;FalseMacroExpression), @Divide(NumeratorExp;;DenominatorExp), @Year(exp), @Month(exp), @Day(exp), @Hour(exp), @Minute(exp), @Second(exp).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: TriggerAttributes -->
        <xsd:attribute name="triggerAttributes" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>ModelAttributes that trigger the formula execution. Example: Property1, Property2, ..., PropertyN</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ForeignKey -->
        <xsd:attribute name="foreignKey" type="xsd:string" />
        <!-- Property: Filter -->
        <xsd:attribute name="filter" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Filter by this attribute (Ex1: [Value] = 10 || [Value] = this.ViewFieldName, Ex2: [Value] &gt;= 20 &amp;&amp; this.ViewFieldName &lt;= 50).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: NotMapped -->
        <xsd:attribute name="notMapped" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Not mapped witht the database.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsComputed -->
        <xsd:attribute name="isComputed" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Entity Framework don&apos;t try to update this column. But EF returns the value from the database after inserting or updating data.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: MaxLength -->
        <xsd:attribute name="maxLength" type="xsd:integer" >
          <xsd:annotation>
            <xsd:documentation>Max Length For Strings</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: SqlDefault -->
        <xsd:attribute name="sqlDefault" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Default column definition.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsDimensionFilterSuggestion -->
        <xsd:attribute name="isDimensionFilterSuggestion" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Besides the primary key, this information indicates that this information is a filter suggestion for dimensions.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: InStudy -->
        <xsd:attribute name="inStudy" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>This property alerts that this property is in study mode.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewSource -->
        <xsd:attribute name="modelViewSource" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Source data property from business query.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewFormula -->
        <xsd:attribute name="modelViewFormula" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Expression for Model View Linq. You also can use a composed key like this: KEY(PROP1,PROP2,PROP3).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: AggregationFunction -->
        <xsd:attribute name="aggregationFunction" type="AggregationFunctions" />
        <!-- Property: ModelViewOrderBySequence -->
        <xsd:attribute name="modelViewOrderBySequence" type="xsd:integer" >
          <xsd:annotation>
            <xsd:documentation>Index for orderby sequence.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewOrderByOrientation -->
        <xsd:attribute name="modelViewOrderByOrientation" type="OrderByOrientationType" />
        <!-- Property: IsCustomized -->
        <xsd:attribute name="isCustomized" type="xsd:boolean" />
        <!-- Property: FilteringDisabled -->
        <xsd:attribute name="filteringDisabled" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Disable data filtering.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ModelViewCountDistinctFilter -->
        <xsd:attribute name="modelViewCountDistinctFilter" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Filter by count distinct (Ex: this.QTDE &gt; 10 || [Value] &lt; 50).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsUniqueValue -->
        <xsd:attribute name="isUniqueValue" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Indicates if this field has a unique value when inserting a new data.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: CustomDataType -->
        <xsd:attribute name="customDataType" type="xsd:string" />
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
