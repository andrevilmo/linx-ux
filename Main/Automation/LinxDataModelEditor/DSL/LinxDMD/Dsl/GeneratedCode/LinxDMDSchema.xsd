          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: ReturnType -->
        <xsd:attribute name="returnType" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Return Type.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Access -->
        <xsd:attribute name="access" type="OperationAccess" >
          <xsd:annotation>
            <xsd:documentation>Operation Access.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: CustomAttributes -->
        <xsd:attribute name="customAttributes" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Custom attribute definitions. All attribute definitions should be separated per # (Attribute1(ParamList2)#Attribute2(ParamList2)#...).</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: Parameters -->
        <xsd:attribute name="parameters" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Parameters Definitions. All parameters should be separated per # (DataType1 ParamName1#DataType2 ParamName2#...). </xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsStatic -->
        <xsd:attribute name="isStatic" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Sets or gets wether or not the item is statically defined.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: CanOverride -->
        <xsd:attribute name="canOverride" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Sets or gets wether or not a function can be overridden.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: OverloadName -->
        <xsd:attribute name="overloadName" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Overload Name for the operation.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: DocComment -->
        <xsd:attribute name="docComment" type="xsd:string" >
          <xsd:annotation>
            <xsd:documentation>Documentation for this opation.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsShared -->
        <xsd:attribute name="isShared" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Sets or gets wether or not the item is shared.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsPartial -->
        <xsd:attribute name="isPartial" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>Indicates a partial method.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
        <!-- Property: IsUniqueOverload -->
        <xsd:attribute name="isUniqueOverload" type="xsd:boolean" >
          <xsd:annotation>
            <xsd:documentation>The operation has only one overload.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
