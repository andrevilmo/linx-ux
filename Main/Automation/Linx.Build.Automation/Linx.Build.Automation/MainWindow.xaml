<Window x:Class="Linx.Build.Automation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update/Compile Business Solutions (BM and BV)" Height="626.052" Width="934" Icon="Linx.ico" Closing="Window_Closing" Background="#FFE8ECF1">
    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="5" VerticalAlignment="Bottom" Background="#FFC9C3C3"   />

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="5">
            <Label Content="Business Solutions Directory:" HorizontalAlignment="Left" />
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxSolutionFolder" Text=""   TextChanged="TxSolutionFolder_TextChanged"/>
                <Button Grid.Column="1" Name="BtSelectDirectory"  Content="..." Width="33" Click="Button_Click" ToolTip="Select Folder" Height="23"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="5,5,5,10" MinHeight="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" >
                <Label Name="LblSolutionInfo" Content="Solutions (0):" />
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <CheckBox x:Name="CkSaveDesigners" Content="Save Designers" IsChecked="True" VerticalAlignment="Center" Margin="5" Unchecked="CkSaveDesigners_Checked"/>
                    <CheckBox x:Name="CkCompileSolution" Content="Compile C# projects" IsChecked="True" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbCompileConfig" ToolTip="Solution Configurations" SelectedIndex="0" Margin="0,5,5,5">
                        <ComboBoxItem Content="Debug"/>
                        <ComboBoxItem Content="Release"/>
                    </ComboBox>
                    <CheckBox x:Name="CkCompileJS" Content="Compile JavaScripts" IsChecked="False" VerticalAlignment="Center" Margin="5"/>
                    <CheckBox x:Name="CkCustomClient" Content="Detect Custom Client" IsChecked="False" VerticalAlignment="Center" Margin="5" Checked="CkCustomClient_Checked"/>
                    <Button x:Name="BtSelectAll" Content="Select All" Margin="2" Width="100"  Cursor="Hand" Click="BtSelectAll_Click"/>
                    <Button x:Name="BtDeselectAll" Content="Deselect All" Margin="2" Width="100" Cursor="Hand" Click="BtDeselectAll_Click"/>
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" Name="lbSolutionList" SelectionMode="Multiple" SelectionChanged="lbSolutionList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility ="Auto" BorderBrush="#FFC9C3C3">
                <ListBox.ItemContainerStyle>
                    <!-- This Style binds a ListBoxItem to a the ViewModelItem. -->
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="IsSelected"
                        Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Image  Source="Solution.png" Margin="0,0,5,0"/>
                            <TextBlock  Text="{Binding Name}" Width="400" Margin="0,0,15,0"/>
                            <TextBlock  Text="{Binding Path}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>


        <GroupBox Grid.Row="2" Header="Process Result" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBox IsReadOnly="True" Name="TxOutput" TextWrapping="Wrap" Text="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </ScrollViewer>
        </GroupBox>


        <StackPanel Grid.Row="3"   Margin="5" HorizontalAlignment="Stretch">
            <TextBlock x:Name="StatusLabel" Text="..." Height="17"  />
            <ProgressBar Name="CtrlProgress" HorizontalAlignment="Stretch" Height="17" Margin="1" />
            <TextBlock x:Name="StatusDesigners" Text="..." Height="17"  />
            <ProgressBar x:Name="CtrlProgressDesigners" HorizontalAlignment="Stretch" Height="17" Margin="1"/>
        </StackPanel>


        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Name="BtProcess" Content="Execute Process" Margin="2,0,2,2" Width="100" Click="BtProcess_Click" Height="26" Cursor="Hand" VerticalAlignment="Bottom"/>
            <Button x:Name="BtCancel" Content="Cancel Process" Margin="2" Width="100" Height="26" Click="BtCancel_Click" IsEnabled="False" Cursor="Hand"/>
        </StackPanel>




    </Grid>
</Window>
