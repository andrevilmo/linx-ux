{
  "name": "HelloIonic",
  "private": "true",
  "dependencies": {
    "ace-builds": "~1.2.0",
    "angular": "~1.4.6",
    "angular-animate": "~1.4.6",
    "angular-bootstrap": "0.13.0",
    "angular-bootstrap-select": "~0.0.5",
    "angular-drag-and-drop-lists": "~1.3.0",
    "angular-dragdrop": "~1.0.12",
    "angular-formly": "~7.1.1",
    "angular-gridster": "~0.13.5",
    "angular-rt-popup": "~1.0.6",
    "angular-sanitize": "~1.4.6",
    "angular-tree-control": "~0.2.15",
    "angular-ui-ace": "~0.2.3",
    "handlebars": "~4.0.2",
    "javascript-detect-element-resize": "~0.5.3",
    "jquery": "~2.1.4",
    "jquery-ui": "~1.11.4",
    "underscore": "~1.8.3",
    "angular-formly-templates-bootstrap": "https://heitorestrela@bitbucket.org/heitorestrela/linx-formly.git",
    "angular-ui-router": "~0.2.15",
    "AngularJS-Toaster": "angularjs-toaster#~0.4.15",
    "lxFlexmonster": "https://Fcamaralinx:fcamara123@bitbucket.org/Fcamaralinx/lxflexmonster.git#v3.0",
    "ng-context-menu": "~1.0.2",
    "angular-route": "~1.4.7"
  },
  "resolutions": {
    "angular": "~1.4.6"
  },
  "install": {
    "path": {
      "css": "libs/dist/{name}/css",
      "js": "libs/dist/{name}/js",
      "png": "libs/dist/{name}/images",
      "jpg": "libs/dist/{name}/images",
      "gif": "libs/dist/{name}/images",
      "eot": "libs/dist/{name}/fonts",
      "svg": "libs/dist/{name}/fonts",
      "ttf": "libs/dist/{name}/fonts",
      "woff": "libs/dist/{name}/fonts",
      "woff2": "libs/dist/{name}/fonts"
    },
    "sources": {
      "ace-builds": [
        "libs/bower/ace-builds/src-min/**"
      ],
      "angular": [
        "libs/bower/angular/*.min.js"
      ],
      "angular-animate": [
        "libs/bower/angular-animate/*.min.js"
      ],
      "angular-bootstrap": [
        "libs/bower/angular-bootstrap/ui-bootstrap-tpls.min.js"
      ],
      "angular-bootstrap-select": [
        "libs/bower/angular-bootstrap-select/build/*.min.js"
      ],
      "angular-drag-and-drop-lists": [
        "libs/bower/angular-drag-and-drop-lists/*.min.js"
      ],
      "angular-dragdrop": [
        "libs/bower/angular-dragdrop/src/*.min.js"
      ],
      "angular-formly": [
        "libs/bower/angular-formly/dist/*.min.js"
      ],
      "angular-gridster": [
        "libs/bower/angular-gridster/dist/*.min.js",
        "libs/bower/angular-gridster/dist/*.min.css"
      ],
      "angular-rt-popup": [
        "libs/bower/angular-rt-popup/dist/*.min.js"
      ],
      "angular-sanitize": [
        "libs/bower/angular-sanitize/*.min.js"
      ],
      "angular-ui-ace": [
        "libs/bower/angular-ui-ace/*.min.js"
      ],
      "bootstrap-select": [
        "libs/bower/bootstrap-select/*.min.js",
        "libs/bower/bootstrap-select/*.min.css"
      ],
      "handlebars": [
        "libs/bower/handlebars/handlebars.min.js"
      ],
      "javascript-detect-element-resize": [
        "libs/bower/javascript-detect-element-resize/*.js"
      ],
      "jquery-ui": [
        "libs/bower/jquery-ui/*.min.js"
      ],
      "underscore": [
        "libs/bower/underscore/*-min.js"
      ],
      "angular-tree-control": [
        "libs/bower/angular-tree-control/css/tree-control-attribute.css",
        "libs/bower/angular-tree-control/images/**",
        "libs/bower/angular-tree-control/angular-tree-control.js"
      ],
      "angular-formly-templates-bootstrap": [
        "libs/bower/angular-formly-templates-bootstrap/angular-formly-templates-bootstrap.min.js"
      ],
      "angular-ui-router": [
        "libs/bower/angular-ui-router/release/angular-ui-router.min.js"
      ],
      "AngularJS-Toaster": [
        "libs/bower/AngularJS-Toaster/toaster.min.js",
        "libs/bower/AngularJS-Toaster/toaster.min.css"
      ],
      "lxFlexmonster": [
        "libs/bower/flexmonster/flexmonster.js",
        "libs/bower/lxFlexmonster/dist/lxFlexmonster.bundle.min.js"
      ]
    }
  }
}
