<Window x:Class="Microsoft.VisualStudio.Modeling.Sdk.ModelBusAuthoringDslDesignerExtension.ModelBusReferencePropertiesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="560" Height="600" Title="Properties for a DomainProperty of type ModelBusReference" FontSize="12" MinHeight="600" MinWidth="560" Background="#FFF0F0F0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>


        <RichTextBox Grid.Row="0" BorderThickness="0" Focusable="False" IsReadOnly="True" Padding="5">
            <RichTextBox.Background>
                <SolidColorBrush />
            </RichTextBox.Background>
            <FlowDocument >
                <Paragraph>The following settings will be used by the
                    <Bold>ModelBus Picker dialog</Bold>. If you do not do anything, the picker dialog will
                propose the user to open any file, and, if this is a model file, it will propose the user to choose any model element type. 
                    This settings enable you, as a DSL author
                to configure what the DSL user will be able to pick.</Paragraph>
            </FlowDocument>
        </RichTextBox>
        <GroupBox Margin="5" Header="Kind of ModelBusReference" Grid.Row="1" FontWeight="Bold">
            <StackPanel >
                <Label BorderThickness="0" FontWeight="Normal">This ModelBusReference property is a reference to:</Label>
                <RadioButton Name="isReferenceToModelElement" IsChecked="True" Margin="15,2,5,5" BorderThickness="0" FontWeight="Normal" Content="a model element">

                </RadioButton>
                <RadioButton Name="isReferencetoModel" Margin="15,2,5,5" BorderThickness="0" FontWeight="Normal">a model only</RadioButton>
            </StackPanel>
        </GroupBox>
        <GroupBox Margin="5" Header="Model file browsing options" Grid.Row="2" FontWeight="Bold">
            <StackPanel>
                <RichTextBox Background="Transparent" BorderThickness="0" FontWeight="Normal" Focusable="False" Padding="5">
                    <FlowDocument>
                        <Paragraph>Optionally, for file based models browsing, you can supply:</Paragraph>
                    </FlowDocument>
                  </RichTextBox>
                <RichTextBox Background="Transparent" BorderThickness="0" FontWeight="Normal" IsReadOnly="True" Focusable="False">
                    <FlowDocument>
                        <Paragraph>- the
                            <Bold>caption</Bold> that will be displayed in the file dialog (for instance
                                        “Choose a model file”)
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
                <TextBox Name="pickerUiCaption" Margin="14,2,5,5" FontWeight="Normal"></TextBox>
                <RichTextBox  Background="Transparent" BorderThickness="0" FontWeight="Normal" IsReadOnly="True" >
                    <FlowDocument>
                        <Paragraph>-The
                            <Bold>file dialog filter string</Bold> (for instance: "MyModel file|*.mydsl".
                            <Hyperlink NavigateUri="http://msdn.microsoft.com/en-us/library/microsoft.win32.filedialog.filter.aspx" Foreground="Blue" IsEnabled="True">Learn more</Hyperlink>)
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
                <TextBox Name="pickerUiFilterString" Margin="14,2,5,5" FontWeight="Normal"></TextBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Name="modelElementTypeLimitations" Margin="5" Header="Model Element type restrictions" Grid.Row="3" FontWeight="Bold" IsEnabled="{Binding ElementName=isReferenceToModelElement, Path=IsChecked}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <RichTextBox BorderThickness="0" FontWeight="Normal" IsReadOnly="True" Focusable="False" Padding="5">
                    <RichTextBox.Background>
                        <SolidColorBrush />
                    </RichTextBox.Background>
                    <FlowDocument>
                        <Paragraph>It is possible to filter the type of model elements so that the DSL user only chooses among those types.
                    Please type in the textbox below the fully qualified names of the types you want the user to pick from (one per
                    line)</Paragraph>
                    </FlowDocument>
                </RichTextBox>
                <TextBox Grid.Row="1" Name="pickerUiAuthorizedTypes" Margin="5" FontWeight="Normal" AcceptsTab="True" AcceptsReturn="True"></TextBox>
            </Grid>
        </GroupBox>

        <Separator Margin="2,5,2,5" Grid.Row="4" />


        <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="0" Grid.Row="5">
            <Button Margin="10,5,10,5" Padding="2" Width="80" IsDefault="True" Click="OkButton_Click">
                <Button.Content>Ok</Button.Content>
                
            </Button>
            <Button Margin="10,5,10,5" Padding="2" Width="80" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
    
</Window>
