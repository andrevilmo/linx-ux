<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>ModelBusAdapters</Name>
    <Description>Enables to expose a DSL to the ModelBus</Description>
    <ProjectType>CSharp</ProjectType>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>ModelBusAdapters</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.ico</Icon>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="ModelBusAdapters.csproj" File="ModelBusAdapters.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="Adapter.tt">Adapter.tt</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Adapter.cs">Adapter.cs</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="AdapterManager.tt">AdapterManager.tt</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="AdapterManager.cs">AdapterManager.cs</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="AdapterManagerHelperMethods.tt">AdapterManagerHelperMethods.tt</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="AdapterManagerHelperMethods.cs">AdapterManagerHelperMethods.cs</ProjectItem>
      <Folder Name="Properties" TargetFolderName="Properties">
        <ProjectItem ReplaceParameters="true" TargetFileName="AssemblyInfo.cs">AssemblyInfo.cs</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true" TargetFileName="Readme.htm">Readme.htm</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>