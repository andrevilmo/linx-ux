      ],
      "options": {
        "cwd": "${workspaceFolder}/Application/Linx.Portal"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Deploy Linx.Portal.dll",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Application/Linx.Portal/.vscode/deploy-portal-views.ps1",
        "-Dll",
        "Linx.Portal.dll",
        "-DllsOnly"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Application/Linx.Portal"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Deploy Service DLLs (updated only)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS/.vscode/deploy-service-dlls.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Deploy Current Service DLL",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS/.vscode/deploy-service-dlls.ps1",
        "-File",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Deploy Linx.Tools.dll",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS/.vscode/deploy-service-dlls.ps1",
        "-Dll",
        "Linx.Tools.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Deploy Linx.Framework.BV.dll",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS/.vscode/deploy-service-dlls.ps1",
        "-Dll",
        "Linx.Framework.BV.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Business/Linx.Framework.BV/Linx.Framework.BV.WebAPI.DS"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
