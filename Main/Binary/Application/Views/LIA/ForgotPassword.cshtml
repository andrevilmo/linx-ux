@{
    Layout = null;
    var loginUrl = this.ViewData["_loginUrl"] as string;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperação de senha</title>
    <link rel="shortcut icon" href="@Url.Content("~/favicon.ico")" />
    <style type="text/css">
        body { font-family: "Segoe UI", Arial, sans-serif; background: #f2f3f8; color: #333; margin: 0; }
        .box { max-width: 380px; margin: 80px auto; background: #fff; border: 1px solid #e1e4ea; border-radius: 6px; padding: 32px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
        h1 { font-size: 20px; margin: 0 0 8px; }
        p.sub { font-size: 13px; color: #777; margin: 0 0 24px; }
        label { display: block; font-size: 13px; margin: 14px 0 4px; }
        input[type=text] { width: 100%; box-sizing: border-box; padding: 9px 10px; border: 1px solid #ccd1da; border-radius: 4px; font-size: 14px; }
        button { width: 100%; margin-top: 22px; padding: 11px; border: 0; border-radius: 4px; background: #2b6cde; color: #fff; font-size: 14px; cursor: pointer; }
        button:disabled { background: #9bb6e8; cursor: default; }
        .msg { margin-top: 16px; font-size: 13px; }
        .msg.error { color: #c0392b; }
        .msg.success { color: #1e8449; }
        a { color: #2b6cde; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Recuperação de senha</h1>
        <p class="sub">Informe o seu usuário para receber um link de redefinição por e-mail.</p>

        <form id="recoverForm">
            <label for="userName">Usuário</label>
            <input type="text" id="userName" autocomplete="off" autofocus />

            <button type="submit" id="submitBtn">Enviar link por e-mail</button>
            <div id="message" class="msg"></div>
        </form>

        <p style="margin-top:18px;"><a href="@loginUrl">Voltar para o login</a></p>
    </div>

    <script type="text/javascript">
        (function () {
            var form = document.getElementById('recoverForm');
            var btn = document.getElementById('submitBtn');
            var msg = document.getElementById('message');

            function setMessage(text, type) {
                msg.textContent = text;
                msg.className = 'msg ' + (type || '');
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var userName = (document.getElementById('userName').value || '').replace(/^\s+|\s+$/g, '');
                if (!userName) { setMessage('Informe o usuário.', 'error'); return; }

                btn.disabled = true;
                setMessage('Enviando...', '');

                fetch('@Url.Content("~/SendPasswordResetLink")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'userName=' + encodeURIComponent(userName)
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    btn.disabled = false;
                    if (data && data.success) {
                        setMessage(data.message, 'success');
                    } else {
                        setMessage((data && data.message) ? data.message : 'Não foi possível enviar o e-mail.', 'error');
                    }
                })
                .catch(function () {
                    btn.disabled = false;
                    setMessage('Erro de comunicação. Tente novamente.', 'error');
                });
            });
        })();
    </script>
</body>
</html>
