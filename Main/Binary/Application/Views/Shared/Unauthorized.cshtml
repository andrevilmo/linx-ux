<style>
    body {
        background-color: #5b2e90 !important;
        color: #ff9200;
        margin: 0;
        padding: 0;
    }

    .page-401 {
        margin: 0 auto;
        width: 100%;
        text-align: center;
    }

        .page-401 p, .page-401 a {
            font-size: 1em;
        }

        .page-401 h2, .page-401 a {
            text-transform: uppercase;
        }

        .page-401 a {
            color: #ff9200;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            width: 88px;
            height: 44px;
            line-height: 44px;
            border-radius: 5px !important;
            ;
            border: 2px solid #ff9200;
            transition: all .5s ease;
            text-decoration: none !important;
        }

            .page-401 a:hover {
                background: #ff9200;
                border: 2px solid #ff9200;
                width: 132px;
                color: #5b2e90;
                text-decoration: none !important;
            }

    /* smartphones, portrait iPhone, portrait 480x320 phones (Android) */
    @@media (min-width:320px) {
        .page-401 h1 {
            font-size: 2em;
        }

        .page-401 h2 {
            font-size: 1.5em;
        }
    }

    /* smartphones, Android phones, landscape iPhone */
    @@media (min-width:480px) {
        .page-401 h1 {
            font-size: 3em;
        }

        .page-401 h2 {
            font-size: 1.75em;
        }
    }

    /* portrait tablets, portrait iPad, e-readers (Nook/Kindle), landscape 800x480 phones (Android) */
    @@media (min-width:600px) {
        .page-401 h1 {
            font-size: 4em;
        }

        .page-401 h2 {
            font-size: 2em;
        }
    }

    /* tablet, landscape iPad, lo-res laptops ands desktops */
    @@media (min-width:801px) {
        .page-401 h1 {
            font-size: 5em;
        }

        .page-401 h2 {
            font-size: 3em;
        }
    }


    /* big landscape tablets, laptops, and desktops */
    @@media (min-width:1025px) {
        .page-401 h1 {
            font-size: 6em;
        }

        .page-401 h2 {
            font-size: 4em;
        }
    }


    /* hi-res laptops and desktops */
    @@media (min-width:1281px) {
        .page-401 h1 {
            font-size: 7em;
        }

        .page-401 h2 {
            font-size: 5em;
        }
    }
</style>


@{
    ViewBag.Title = "Unauthorized";
    Layout = "~/Views/Shared/_LayoutClean.cshtml";
}

<div class="page-401">
    <h2>Sem autorização</h2>
    <p style="margin: 20px 0">Usuário sem permissão para acessar esta página</p>
    <p><a href="@this.ViewData["_loginUrl"]" id="linkPortal">Faça login</a></p>
    <p style="margin-top: 12px;"><a href="@Url.Content("~/ForgotPassword")">Esqueci minha senha</a></p>
</div>
