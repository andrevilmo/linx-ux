@model Linx.Portal.Models.LogOnModel
@{
    ViewBag.Title = "Login - Linx Portal";
}
<style type="text/css">
    body:before{
        background-image: url('@Url.Content("~/assets/img/bg-interna-segmentos-moda2.jpg")')
    }
    #authentication {
        min-height: 100vh;
    }
    #authentication footer {
        z-index: 1;
    }
    #login .forget-password a {
        color: #5B2E90;
        text-decoration: none;
    }
</style>
<article id="login">
    <section id="info-product" >
        <div class="page-brand-info">
            <div class="brand">
                <img class="brand-img" src="~/assets/img/prh-logo-linx-h.png" alt="...">
            </div>
            <p class="font-size-20">
                SOFTWARE QUE MOVE O VAREJO
            </p>
        </div>
        <footer>
            <p> &copy; Linx - Todos os direitos reservados. </p>
        </footer>
    </section>

    <section id="authentication">
        <div class="page-brand-info">
            <div class="brand">
                <img class="brand-img" src="~/assets/img/linxPreto.png" alt="...">
            </div>
            <p class="font-size-20">
                SOFTWARE QUE MOVE O VAREJO
            </p>
        </div>
        <div class="ux-logo">
            <img class="linx-img" src="~/assets/img/linxX.png" />
        </div>
        @{
            var ssoEnabled = Linx.Portal.Utils.IsSsoEnabled();
            var ssoContingency = ssoEnabled && Session != null && Session[Linx.Portal.Authentication.SsoLoginHelper.ContingencySessionKey] != null
                && Convert.ToBoolean(Session[Linx.Portal.Authentication.SsoLoginHelper.ContingencySessionKey]);
            var showLocalLogin = !ssoEnabled || Linx.Portal.Utils.IsSsoOfflineFallbackAllowed() || ssoContingency;
        }

        @if (ssoEnabled)
        {
            <div class="sso-login" style="margin-bottom: 24px;">
                <div class="button-row" style="margin-left: 0; width: 100%;">
                    <a id="btnSsoLogin" href="@Url.Action("SsoLogin", "Account")" class="sso-button" style="display:inline-block; text-align:center; width:100%; padding:10px 12px; background:#5B2E90; color:#fff; text-decoration:none;">entrar com Microsoft</a>
                </div>
                @if (ssoContingency)
                {
                    <p class="sso-contingency-hint" style="margin-top:12px; color:#8a6d3b;">SSO em contingência — use usuário e senha local.</p>
                }
                else if (showLocalLogin)
                {
                    <p class="sso-or" style="margin-top:16px; text-align:center; opacity:0.7;">ou</p>
                }
            </div>
        }

        <form id="FormLogIn" method="post" style="@(showLocalLogin ? "" : "display:none;")">

            <div class="form-validation-response">
                @if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count() > 0)
                {
                    foreach (var error in ViewData.ModelState[""].Errors)
                    {
                        <label class="error-message">@error.ErrorMessage</label>
                    }
                }
                @if (@ViewBag.SuccessMessage != null)
                {

                    <label class="success-message">@ViewBag.SuccessMessage</label>
                }
            </div>

            <label>usuário  <input type="text" id="UserName" name="UserName" autofocus="autofocus" required="required" autocomplete="off" />   </label>
            <label>senha    <input type="password" id="Password" name="Password" required="required" autocomplete="off" />         </label>

            <div class="checkbox-row">
                <input type="checkbox" checked="checked" name="RememberMe" id="RememberMe" value="true" />
                <label for="RememberMe">mantenha-me conectado</label>
            </div>
            <div class="button-row">
                <button type="button" id="btnSubmitEnvironments" style="visibility: @(Linx.Portal.Utils.GetListEnvironmentOptionOnLogin()?"visible": "hidden");">listar ambientes</button>
                <button type="button" id="btnSubmit">entrar</button>
            </div>

            <button type="submit" id="submitHidden" display="none"></button>
            <input type="hidden" name="ShowEnvironments" id="ShowEnvironments" value="false" />
            <input type="hidden" id="RecoverPassword" name="RecoverPassword" value="false" />
        </form>

        @if (!showLocalLogin && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count() > 0)
        {
            <div class="form-validation-response">
                @foreach (var error in ViewData.ModelState[""].Errors)
                {
                    <label class="error-message">@error.ErrorMessage</label>
                }
            </div>
        }

        <div id="recoverSection" style="display:none;">
            <form id="FormRecovery" method="post">
                <div class="form-validation-response">
                    <label id="recoverMessage"></label>
                </div>
                <label>usuário <input type="text" id="RecoverUserName" autocomplete="off" /></label>
                <div class="button-row">
                    <button type="button" id="btnRequestRecover" style="width: 170px;">enviar link por e-mail</button>
                </div>
                <div class="forget-password">
                    <a href="#" id="backToLoginFromRecover">voltar ao login</a>
                </div>
            </form>
        </div>

        <div id="resetSection" style="display:none;">
            <form id="FormReset" method="post">
                <div class="form-validation-response">
                    <label id="resetMessage"></label>
                </div>
                <label>nova senha <input type="password" id="NewPassword" autocomplete="new-password" /></label>
                <label>confirmar senha <input type="password" id="ConfirmPassword" autocomplete="new-password" /></label>
                <div class="button-row">
                    <button type="button" id="btnSubmitReset">redefinir senha</button>
                </div>
                <div class="forget-password">
                    <a href="#" id="backToLoginFromReset">voltar ao login</a>
                </div>
            </form>
        </div>

            @if (@Linx.Portal.Utils.GetRecoverPasswordOption() && showLocalLogin)
            {
                <div class="forget-password" id="loginForgetPassword">
                    <a href="#" id="forgotPassword">Esqueci minha senha</a>
                </div>
            }
        <ul class="ul-redes">
            <li><a class="www" href="https://www.linx.com.br/" target="_blank"><img src='@Url.Content("~/assets/img/icon-redes-sociais.png")'></a></li>
            <li><a class="fb" href="http://www.facebook.com/linxretail" target="_blank"><img src='@Url.Content("~/assets/img/icon-redes-sociais.png")'></a></li>
            <li><a class="tw" href="https://www.twitter.com/linxretail" target="_blank"><img src='@Url.Content("~/assets/img/icon-redes-sociais.png")'></a></li>
            <li><a class="in" href="http://www.linkedin.com/company/linxretail" target="_blank"><img src='@Url.Content("~/assets/img/icon-redes-sociais.png")'></a></li>
            <li><a class="you" href="http://www.youtube.com/user/linxretail" target="_blank"><img src='@Url.Content("~/assets/img/icon-redes-sociais.png")'></a></li>
            <li><a class="stag" href="http://instagram.com/linxretail" target="_blank"><img src='@Url.Content("~/assets/img/icon-redes-sociais.png")'></a></li>
        </ul>
        <footer>
            <p>&copy; Linx - Todos os direitos reservados.</p>
        </footer>
    </section>
</article>               
<script type="text/javascript">
    function ready(fn) {
        if (document.readyState != 'loading') {
            fn();
        } else {
            document.addEventListener('DOMContentLoaded', fn);
        }
    }

    ready(function () {

        var urls = {
            sendLink: '@Url.Action("SendPasswordResetLink", "Account")',
            validateToken: '@Url.Action("ValidateResetToken", "Account")',
            resetPassword: '@Url.Action("ResetPassword", "Account")',
            login: '@Url.Action("Login", "Account")'
        };

        var form = document.getElementById('FormLogIn');
        var recoverPassword = document.getElementById('RecoverPassword');
        var btnSubmitEnvironments = document.getElementById('btnSubmitEnvironments');
        var btnSumit = document.getElementById('btnSubmit');
        var forgotPassword = document.getElementById('forgotPassword');
        var showEnviroments = document.getElementById('ShowEnvironments');
        var password = document.getElementById('Password');
        var submitHidden = document.getElementById('submitHidden');

        var recoverSection = document.getElementById('recoverSection');
        var resetSection = document.getElementById('resetSection');
        var recoverUserName = document.getElementById('RecoverUserName');
        var btnRequestRecover = document.getElementById('btnRequestRecover');
        var backToLoginFromRecover = document.getElementById('backToLoginFromRecover');
        var recoverMessage = document.getElementById('recoverMessage');
        var newPassword = document.getElementById('NewPassword');
        var confirmPassword = document.getElementById('ConfirmPassword');
        var btnSubmitReset = document.getElementById('btnSubmitReset');
        var resetMessage = document.getElementById('resetMessage');

        // ---- login handlers (existing behavior) ----
        btnSumit.addEventListener('click', function () {
            password.setAttribute('required', true);
            recoverPassword.value = false;
            submitHidden.click();
        });

        btnSubmitEnvironments.addEventListener('click', function () {
            password.setAttribute('required', true);
            recoverPassword.value = false;
            showEnviroments.value = true;
            submitHidden.click();
        });

        function setRecoverBusy(busy) {
            btnRequestRecover.disabled = busy;
            if (busy) {
                backToLoginFromRecover.style.pointerEvents = 'none';
                backToLoginFromRecover.style.opacity = '0.5';
                backToLoginFromRecover.setAttribute('aria-disabled', 'true');
            } else {
                backToLoginFromRecover.style.pointerEvents = '';
                backToLoginFromRecover.style.opacity = '';
                backToLoginFromRecover.removeAttribute('aria-disabled');
            }
        }

        // ---- helpers ----
        function getQueryParam(name) {
            name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
            var regex = new RegExp("[\\?&]" + name + "=([^&#]*)");
            var results = regex.exec(location.search);
            return results == null ? null : decodeURIComponent(results[1].replace(/\+/g, " "));
        }
        function hasQueryParam(name) {
            var regex = new RegExp("[\\?&]" + name + "(=|&|$)");
            return regex.test(location.search);
        }
        function setMessage(el, text, type) {
            el.textContent = text;
            el.style.display = text ? '' : 'none';
            el.style.color = type === 'success' ? '#1e8449' : (type === 'error' ? '#c0392b' : '');
        }
        function postForm(url, data, cb) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', url, true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.onreadystatechange = function () {
                if (xhr.readyState === 4) {
                    var res = null;
                    try { res = JSON.parse(xhr.responseText); } catch (e) { }
                    cb(xhr.status === 200, res);
                }
            };
            var body = [];
            for (var k in data) { body.push(encodeURIComponent(k) + '=' + encodeURIComponent(data[k])); }
            xhr.send(body.join('&'));
        }
        function getJson(url, cb) {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', url, true);
            xhr.onreadystatechange = function () {
                if (xhr.readyState === 4) {
                    var res = null;
                    try { res = JSON.parse(xhr.responseText); } catch (e) { }
                    cb(xhr.status === 200, res);
                }
            };
            xhr.send();
        }

        // ---- password rules (same as modalChangePassword.js) ----
        var regexExpression = /^(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[~!@@#$%^&*+\-\/\.,\\{}\[\]();:?<>"'_])[A-Za-z\d~!@@#$%^&*+\-\/\.,\\{}\[\]();:?<>"'_]{12,}$/;
        var regexMessage = "A senha deve ter no mínimo 12 caracteres, conter ao menos uma letra maiúscula, uma letra minúscula, um número e um caracter especial permitido";
        var sequentialNumbersMessage = "A senha não pode conter números em sequência (ex.: 123 ou 987)";

        function hasSequentialNumbers(value, sequenceLength) {
            sequenceLength = sequenceLength || 3;
            if (!value || value.length < sequenceLength) return false;
            for (var i = 0; i <= value.length - sequenceLength; i++) {
                var slice = value.substring(i, i + sequenceLength);
                if (!/^\d+$/.test(slice)) continue;
                var ascending = true, descending = true;
                for (var j = 1; j < slice.length; j++) {
                    var diff = slice.charCodeAt(j) - slice.charCodeAt(j - 1);
                    if (diff !== 1) ascending = false;
                    if (diff !== -1) descending = false;
                }
                if (ascending || descending) return true;
            }
            return false;
        }

        // ---- mode switching ----
        var loginForgetPassword = document.getElementById('loginForgetPassword');
        function showLogin() {
            form.style.display = '';
            if (loginForgetPassword) loginForgetPassword.style.display = '';
            recoverSection.style.display = 'none';
            resetSection.style.display = 'none';
        }
        function showRecover(userName) {
            form.style.display = 'none';
            if (loginForgetPassword) loginForgetPassword.style.display = 'none';
            resetSection.style.display = 'none';
            recoverSection.style.display = '';
            if (userName) recoverUserName.value = userName;
            recoverUserName.focus();
        }
        function showReset() {
            form.style.display = 'none';
            if (loginForgetPassword) loginForgetPassword.style.display = 'none';
            recoverSection.style.display = 'none';
            resetSection.style.display = '';
            newPassword.focus();
        }

        if (forgotPassword) {
            forgotPassword.addEventListener('click', function (e) {
                e.preventDefault();
                showRecover(null);
            });
        }
        backToLoginFromRecover.addEventListener('click', function (e) {
            e.preventDefault();
            if (backToLoginFromRecover.getAttribute('aria-disabled') === 'true') return;
            window.location.href = urls.login;
        });
        document.getElementById('backToLoginFromReset').addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = urls.login;
        });

        // ---- request recover link by e-mail ----
        btnRequestRecover.addEventListener('click', function () {
            var user = (recoverUserName.value || '').replace(/^\s+|\s+$/g, '');
            if (!user) { setMessage(recoverMessage, 'Informe o usuário.', 'error'); return; }
            setRecoverBusy(true);
            setMessage(recoverMessage, 'Enviando...', '');
            postForm(urls.sendLink, { userName: user }, function (ok, res) {
                setRecoverBusy(false);
                if (ok && res && res.success) setMessage(recoverMessage, res.message, 'success');
                else setMessage(recoverMessage, (res && res.message) ? res.message : 'Não foi possível enviar o e-mail.', 'error');
            });
        });

        // ---- submit new password (reset with token) ----
        var token = getQueryParam('token');
        btnSubmitReset.addEventListener('click', function () {
            var np = newPassword.value || '';
            var cp = confirmPassword.value || '';
            if (!np) { setMessage(resetMessage, 'Campo obrigatório', 'error'); return; }
            if (!regexExpression.test(np)) { setMessage(resetMessage, regexMessage, 'error'); return; }
            if (hasSequentialNumbers(np)) { setMessage(resetMessage, sequentialNumbersMessage, 'error'); return; }
            if (np !== cp) { setMessage(resetMessage, 'Senha não compatível', 'error'); return; }

            btnSubmitReset.disabled = true;
            setMessage(resetMessage, 'Processando...', '');
            postForm(urls.resetPassword, { token: token, newPassword: np }, function (ok, res) {
                if (ok && res && res.success) {
                    setMessage(resetMessage, res.message + ' Redirecionando...', 'success');
                    setTimeout(function () { window.location.href = urls.login; }, 2500);
                } else {
                    btnSubmitReset.disabled = false;
                    setMessage(resetMessage, (res && res.message) ? res.message : 'Não foi possível redefinir a senha.', 'error');
                }
            });
        });

        // ---- initial mode detection ----
        var recoverParamPresent = hasQueryParam('recoverpassword') || (location.hash && location.hash.toLowerCase() === '#recoverpassword');
        var recoverUserParam = getQueryParam('recoverpassword');

        if (token) {
            // hide login immediately while the token is validated
            form.style.display = 'none';
            getJson(urls.validateToken + '?token=' + encodeURIComponent(token), function (ok, res) {
                if (ok && res && res.valid) {
                    showReset();
                } else {
                    showLogin();
                    var box = form.querySelector('.form-validation-response');
                    if (box) {
                        var lbl = document.createElement('label');
                        lbl.style.color = '#c0392b';
                        lbl.textContent = 'O link de redefinição é inválido ou expirou. Solicite um novo.';
                        box.appendChild(lbl);
                    }
                }
            });
        } else if (recoverParamPresent) {
            showRecover(recoverUserParam);
        } else {
            showLogin();
        }
    });
</script>
