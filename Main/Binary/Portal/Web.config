<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="PortalSettings" type="System.Configuration.DictionarySectionHandler" requirePermission="false" />
  </configSections>
  <PortalSettings>
    <add key="authorizationServiceAddress" value="http://localhost:1710/" />
    <add key="PortalUrl" value="http://localhost:8172/" />
    <add key="ShowRecoverPasswordOption" value="true" />
    <add key="ShowListEnvironmentOptionOnLogin" value="true" />
    <!-- Azure AD SSO (OmniPOS MSAL pattern). Disabled by default. -->
    <add key="SSO_HABILITA_AUTENTICACAO" value="false" />
    <add key="SSO_CLIENT_ID" value="" />
    <add key="SSO_TENANT_ID" value="" />
    <add key="SSO_CLIENT_SECRET" value="" />
    <add key="SSO_REDIRECT_URI" value="http://localhost:8172/Account/SsoCallback" />
    <add key="SSO_SCOPES" value="User.Read" />
    <add key="SSO_PERMITE_OFFLINE" value="true" />
    <add key="SSO_TIMEOUT_RESPOSTA" value="120" />
  </PortalSettings>
  <system.web>
    <httpRuntime targetFramework="4.6.1" />
    <compilation targetFramework="4.6.1" />
    <authentication mode="Forms">
      <!--<forms loginUrl="~/" timeout="2880" name=".Linx.Silverlight.ERP.Application_ASPXAUTH" protection="All" path="/" domain="localhost" />-->
      <forms loginUrl="~/" timeout="2880" name=".Linx.Silverlight.ERP.Application_ASPXAUTH" />
    </authentication>
    <machineKey decryptionKey="193B08E6BD78A73AAA3175B879CF638EFF663313F39D12EB" validationKey="D873AFD3AAFDDF662C04142A45C5D833D7E9EF916C228D12CF5B83358686C3BF7D5FA8A4F96EF792C4081AF9D3F5C95F7F0486184BAC14B8E6276F373D10CB48" validation="SHA1" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <!--<staticContent>
      <mimeMap fileExtension=".woff" mimeType="application/x-woff" />
    </staticContent>-->
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" />
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness32" responseBufferLimit="0" />
      <add name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework64\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness64" responseBufferLimit="0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
