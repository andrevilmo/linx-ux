		{
			domains.Add(domainRef.ClassName);   
#>
	<#=domainRef.GetDomainLinqExpression()#>	
    public partial class <#= domainRef.ClassName + (String.IsNullOrEmpty(domainRef.NameSpace) ? "" : " : " + domainRef.NameSpace + "." + domainRef.ClassName) #>
