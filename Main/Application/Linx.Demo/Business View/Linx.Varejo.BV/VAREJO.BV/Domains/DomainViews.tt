		#>			
			private static Dictionary<string, string> domainValues;
			public static Dictionary<string, string> GetValues()
			{
					if (domainValues == null)
					{

						domainValues = <#=(domainRef.ValuesEndpointName.IsNullOrEmpty() ? "new Dictionary<string, string>()" : "GetCustomValues()")#>;				
				<#
					if (domainRef.ValuesEndpointName.IsNullOrEmpty()) {
						foreach(var domainValue in domainRef.Values)
