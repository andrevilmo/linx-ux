<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>WebMarkupMin.Mvc</id>
    <version>0.8.1</version>
    <title>Web Markup Minifier: ASP.NET MVC Extensions</title>
    <authors>Andrey Taritsyn</authors>
    <owners>Andrey Taritsyn</owners>
    <licenseUrl>http://webmarkupmin.codeplex.com/license</licenseUrl>
    <projectUrl>http://webmarkupmin.codeplex.com/</projectUrl>
    <iconUrl>http://download-codeplex.sec.s-msft.com/Download?ProjectName=webmarkupmin&amp;DownloadId=644208</iconUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>WebMarkupMin.Mvc contains 4 action filters: MinifyHtmlAttribute (for minification of HTML code), MinifyXhtmlAttribute (for minification of XHTML code), MinifyXmlAttribute (for minification of XML code) and CompressContentAttribute (for compression of text content by using GZIP or Deflate).</description>
    <summary>WebMarkupMin.Mvc contains 4 action filters: MinifyHtmlAttribute (for minification of HTML code), MinifyXhtmlAttribute (for minification of XHTML code), MinifyXmlAttribute (for minification of XML code) and CompressContentAttribute (for compression of text content by using GZIP or Deflate).</summary>
    <releaseNotes />
    <copyright>Copyright 2013 Andrey Taritsyn - http://www.taritsyn.ru</copyright>
    <language>en-US</language>
    <tags>ASP.NET MVC Markup HTML XHTML XML Minification Minifier Minify</tags>
    <dependencies>
      <dependency id="WebMarkupMin.Web" version="0.8.1" />
    </dependencies>
    <references>
      <reference file="WebMarkupMin.Mvc.dll" />
    </references>
  </metadata>
</package>