@{
    Layout = null;
    var token = (string)ViewBag.Token;
    var tokenValid = ViewBag.TokenValid != null && (bool)ViewBag.TokenValid;
    var loginUrl = this.ViewData["_loginUrl"] as string;
}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redefinição de senha</title>
    <link rel="shortcut icon" href="@Url.Content("~/favicon.ico")" />
    <style type="text/css">
        body { font-family: "Segoe UI", Arial, sans-serif; background: #f2f3f8; color: #333; margin: 0; }
        .box { max-width: 380px; margin: 80px auto; background: #fff; border: 1px solid #e1e4ea; border-radius: 6px; padding: 32px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
        h1 { font-size: 20px; margin: 0 0 8px; }
        p.sub { font-size: 13px; color: #777; margin: 0 0 24px; }
        label { display: block; font-size: 13px; margin: 14px 0 4px; }
        input[type=password] { width: 100%; box-sizing: border-box; padding: 9px 10px; border: 1px solid #ccd1da; border-radius: 4px; font-size: 14px; }
        button { width: 100%; margin-top: 22px; padding: 11px; border: 0; border-radius: 4px; background: #2b6cde; color: #fff; font-size: 14px; cursor: pointer; }
        button:disabled { background: #9bb6e8; cursor: default; }
        .msg { margin-top: 16px; font-size: 13px; }
        .msg.error { color: #c0392b; }
        .msg.success { color: #1e8449; }
        a { color: #2b6cde; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Redefinição de senha</h1>

        @if (!tokenValid)
        {
            <p class="sub">O link de redefinição é inválido ou expirou.</p>
            <p class="msg error">Solicite um novo link de redefinição de senha.</p>
            <p><a href="@Url.Content("~/ForgotPassword")">Solicitar novo link</a> &nbsp;|&nbsp; <a href="@loginUrl">Voltar para o login</a></p>
        }
        else
        {
            <p class="sub">Defina a sua nova senha de acesso.</p>

            <form id="resetForm">
                <input type="hidden" id="token" value="@token" />

                <label for="newPassword">Nova senha</label>
                <input type="password" id="newPassword" autocomplete="new-password" />

                <label for="confirmPassword">Confirmar nova senha</label>
                <input type="password" id="confirmPassword" autocomplete="new-password" />

                <button type="submit" id="submitBtn">Redefinir senha</button>
                <div id="message" class="msg"></div>
            </form>

            <p style="margin-top:18px;"><a href="@loginUrl">Voltar para o login</a></p>
        }
    </div>

    @if (tokenValid)
    {
        <script type="text/javascript">
            (function () {
                var form = document.getElementById('resetForm');
                var btn = document.getElementById('submitBtn');
                var msg = document.getElementById('message');
                var loginUrl = '@Html.Raw(loginUrl)';

                function setMessage(text, type) {
                    msg.textContent = text;
                    msg.className = 'msg ' + (type || '');
                }

                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    var token = document.getElementById('token').value;
                    var newPassword = document.getElementById('newPassword').value;
                    var confirmPassword = document.getElementById('confirmPassword').value;

                    if (!newPassword) { setMessage('Informe a nova senha.', 'error'); return; }
                    if (newPassword !== confirmPassword) { setMessage('As senhas não conferem.', 'error'); return; }

                    btn.disabled = true;
                    setMessage('Processando...', '');

                    var body = 'token=' + encodeURIComponent(token) + '&newPassword=' + encodeURIComponent(newPassword);

                    fetch('@Url.Content("~/ResetPassword")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.success) {
                            setMessage(data.message + ' Você será redirecionado para o login...', 'success');
                            setTimeout(function () { window.location.href = loginUrl; }, 2500);
                        } else {
                            btn.disabled = false;
                            setMessage((data && data.message) ? data.message : 'Não foi possível redefinir a senha.', 'error');
                        }
                    })
                    .catch(function () {
                        btn.disabled = false;
                        setMessage('Erro de comunicação. Tente novamente.', 'error');
                    });
                });
            })();
        </script>
    }
</body>
</html>
