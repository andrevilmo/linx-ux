@{
    Layout = null;
    ViewBag.Title = "Licença - Linx Portal";
    var canUnblockByTrust = ViewBag.CanUnblockByTrust as bool? ?? false;
    var managerUserName = ViewBag.ManagerUserName as string ?? (User.Identity.IsAuthenticated ? User.Identity.Name : "");
    var portal = ViewData["_loginUrl"] as string;
    if (string.IsNullOrEmpty(portal) && Session != null)
    {
        portal = Session["loginUrl"] as string;
    }
    if (string.IsNullOrEmpty(portal))
    {
        portal = "http://localhost:8172/";
    }
    if (!portal.EndsWith("/"))
    {
        portal = portal + "/";
    }
    var portalLogin = portal + "Account/Login";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1" />
    <link href="@(portal)favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <title>@ViewBag.Title</title>
    <link href="@(portal)assets/css/reset.css" rel="stylesheet" type="text/css" />
    <link href="@(portal)assets/css/portal.css" rel="stylesheet" type="text/css" />
    <style type="text/css">
        body:before {
            background-image: url('@(portal)assets/img/bg-interna-segmentos-moda2.jpg')
        }
        #authentication {
            min-height: 100vh;
        }
        #authentication footer {
            z-index: 1;
        }
        #login .forget-password a {
            color: #5B2E90;
            text-decoration: none;
        }
        #login .license-hint {
            text-transform: none;
            margin: 0 0 16px 0;
            opacity: 0.85;
            line-height: 1.4;
            font-size: 14px;
        }
        #login .form-validation-response .error-message {
            text-transform: none;
        }
        #login .license-admin-alert {
            text-transform: none;
            display: none;
            margin-top: 8px;
            color: #c0392b;
            line-height: 1.4;
            font-size: 14px;
        }
    </style>
</head>
<body>
<article id="login">
    <section id="info-product">
        <div class="page-brand-info">
            <div class="brand">
                <img class="brand-img" src="@(portal)assets/img/prh-logo-linx-h.png" alt="...">
            </div>
            <p class="font-size-20">
                SOFTWARE QUE MOVE O VAREJO
            </p>
        </div>
        <footer>
            <p> &copy; Linx - Todos os direitos reservados. </p>
        </footer>
    </section>

    <section id="authentication">
        <div class="page-brand-info">
            <div class="brand">
                <img class="brand-img" src="@(portal)assets/img/linxPreto.png" alt="...">
            </div>
            <p class="font-size-20">
                SOFTWARE QUE MOVE O VAREJO
            </p>
        </div>
        <div class="ux-logo">
            <img class="linx-img" src="@(portal)assets/img/linxX.png" />
        </div>

        <form id="FormLicense" method="post" action="#" autocomplete="off">
            <div class="form-validation-response">
                @if (ViewBag.Mensagem != null)
                {
                    <label class="error-message">@Html.Raw(ViewBag.Mensagem)</label>
                }
                <label id="licenseUnblockError" class="error-message" style="display:none;"></label>
                <label id="licenseAdminAlert" class="error-message license-admin-alert">Chame um administrador ou faça login com um perfil de administrador.</label>
            </div>

            @if (canUnblockByTrust)
            {
                <p class="license-hint">Este terminal pode ser desbloqueado em confiança. A liberação será válida somente para este terminal e ficará disponível por um período limitado.</p>
                <input type="hidden" id="unblockUserName" name="userName" value="@managerUserName" />
                <div class="button-row">
                    <button type="button" id="btnUnblockLicense">Desbloqueio</button>
                    <button type="button" id="btnCancelUnblock">Cancelar</button>
                </div>
            }
        </form>

        @if (!canUnblockByTrust)
        {
            <div class="forget-password" id="loginForgetPassword" style="margin-bottom: 50px;">
                <a href="@portalLogin">voltar ao login</a>
            </div>
        }
        <ul class="ul-redes">
            <li><a class="www" href="https://www.linx.com.br/" target="_blank"><img src="@(portal)assets/img/icon-redes-sociais.png"></a></li>
            <li><a class="fb" href="http://www.facebook.com/linxretail" target="_blank"><img src="@(portal)assets/img/icon-redes-sociais.png"></a></li>
            <li><a class="tw" href="https://www.twitter.com/linxretail" target="_blank"><img src="@(portal)assets/img/icon-redes-sociais.png"></a></li>
            <li><a class="in" href="http://www.linkedin.com/company/linxretail" target="_blank"><img src="@(portal)assets/img/icon-redes-sociais.png"></a></li>
            <li><a class="you" href="http://www.youtube.com/user/linxretail" target="_blank"><img src="@(portal)assets/img/icon-redes-sociais.png"></a></li>
            <li><a class="stag" href="http://instagram.com/linxretail" target="_blank"><img src="@(portal)assets/img/icon-redes-sociais.png"></a></li>
        </ul>
        <footer>
            <p>&copy; Linx - Todos os direitos reservados.</p>
        </footer>
    </section>
</article>
@if (canUnblockByTrust)
{
<script type="text/javascript">
    (function () {
        var btn = document.getElementById('btnUnblockLicense');
        var cancel = document.getElementById('btnCancelUnblock');
        var err = document.getElementById('licenseUnblockError');
        var adminAlert = document.getElementById('licenseAdminAlert');
        var form = document.getElementById('FormLicense');
        var portalLogin = '@Html.Raw(portalLogin.Replace("\\", "\\\\").Replace("'", "\\'"))';
        var adminHint = 'Chame um administrador ou faça login com um perfil de administrador.';

        function showError(text, showAdminAlert) {
            err.innerHTML = text || '';
            err.style.display = text ? '' : 'none';
            adminAlert.style.display = showAdminAlert ? '' : 'none';
        }

        function unblock() {
            var user = (document.getElementById('unblockUserName').value || '').replace(/^\s+|\s+$/g, '');
            btn.disabled = true;
            showError('Processando...', false);
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '@Url.Content("~/UnblockLicenseByTrust")', true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.onreadystatechange = function () {
                if (xhr.readyState !== 4) return;
                var res = null;
                try { res = JSON.parse(xhr.responseText); } catch (e) { }
                if (xhr.status === 200 && res && res.success) {
                    window.location.reload();
                    return;
                }
                btn.disabled = false;
                var message = (res && res.message) ? res.message : 'Não foi possível desbloquear a licença.';
                showError(message, true);
                window.alert(message + '\n\n' + adminHint);
            };
            xhr.send('userName=' + encodeURIComponent(user));
        }

        btn.addEventListener('click', unblock);
        cancel.addEventListener('click', function () {
            window.location.href = portalLogin;
        });
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            unblock();
        });
    })();
</script>
}
</body>
</html>
