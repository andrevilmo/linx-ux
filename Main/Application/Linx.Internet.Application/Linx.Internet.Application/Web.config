      <add name="FactoryHandler" path="handler.axd" verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTION" type="Linx.Internet.Application.Framework.Handlers.FactoryHandler, Linx.Internet.Application.Framework"/>
      <add name="AspNetStaticFileHandler-CSS" path="*.css" type="System.Web.StaticFileHandler" verb="GET,HEAD"/>
