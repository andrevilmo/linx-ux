<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Error" internalLogFile="nlog-internal.log" >

  <variable name="myvar" value="myvalue"/>

  <targets>
    <target name="buffer" xsi:type="BufferingWrapper" bufferSize="500">
      <target name="logFile" xsi:type="File"
				fileName="${basedir}\logs\LinxUXLIAService.log"
				layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} ${level:uppercase=true} ${logger} ${event-context:item=type_name} ${event-context:item=type_value} ${message} ${onexception:EXCEPTION OCCURRED\:${exception:format=tostring}"
				maxArchiveFiles="7"
				archiveFileName="${basedir}/logs/LinxUXLIAService_${shortdate}.log"
				archiveEvery="Day"
				archiveNumbering="Rolling"
				concurrentWrites="true"
        encoding="iso-8859-2"/>
    </target>

    <target name="logConsole" xsi:type="Console" layout="${date:format=HH\:mm\:ss.fff} ${level:uppercase=true} ${message} ${onexception:EXCEPTION OCCURRED\:${exception:format=tostring}"/>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logConsole" />
    <logger name="*" minlevel="Trace" writeTo="logFile" final="true"/>
  </rules>

</nlog>