<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='..\ProdutoClienteVenda.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot0" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='..\TST2.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot1" #>
	
<#@ import namespace = "System.Collections.Generic" #>
<#+
private  List<BusinessModelDesignerRoot> GetModels()
{
  List<BusinessModelDesignerRoot> models = new List<BusinessModelDesignerRoot>();
  //Add Models	

	if (!this.BusinessModelDesignerRoot0.NoCode)
		models.Add(this.BusinessModelDesignerRoot0);
		if (!this.BusinessModelDesignerRoot1.NoCode)
		models.Add(this.BusinessModelDesignerRoot1);
	
  return models;
}
#>