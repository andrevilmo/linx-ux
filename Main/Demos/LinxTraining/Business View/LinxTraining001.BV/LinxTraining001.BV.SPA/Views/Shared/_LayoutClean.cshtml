@using System.Web
@using System.Web.Optimization
<!DOCTYPE html>
<!--[if IE 8]> <html lang="en" class="ie8 no-js"> <![endif]-->
<!--[if IE 9]> <html lang="en" class="ie9 no-js"> <![endif]-->
<!--[if !IE]><!-->
<html lang="en" class="no-js">
<!--<![endif]-->
<!-- BEGIN HEAD -->
<head>
	<title>Linx UX</title>
	@Html.MetaHash()
	@Html.MetaVersion()
    @Html.MetaDateVersion()
	@Html.MetaModuleId()
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta content="width=device-width, initial-scale=1.0" name="viewport" />
	<meta content="" name="description" />
	<meta content="" name="author" />
	<meta name="MobileOptimized" content="320">
	<meta http-equiv='content-Type' content='text/html; charset=iso-8859-1' />

	<link rel="shortcut icon" href="@Url.Content("~/favicon.ico")" />

    @Styles.Render(Url.ContentWithModuleId("core-css"))
    <link rel="stylesheet" type="text/css" href="@Url.ContentWithModuleId("~/theme-css-default")" id="style_color"/>

</head>
<!-- END HEAD -->
<!-- BEGIN BODY -->
<body class="page-footer-fixed page-header-fixed page-full-width @Url.ThemeName()">
	@Html.Partial("_HeaderClean")

	<!-- BEGIN CONTAINER -->
	<div class="page-container">
		@RenderBody()
	</div>
	<!-- END CONTAINER -->

	@Html.Partial("_FooterClean")

    <!-- BEGIN JAVASCRIPTS(Load javascripts at bottom, this will reduce page load time) -->
    @Scripts.Render(Url.ContentWithModuleId("core-clean-js"))
	<!-- END JAVASCRIPTS -->

	<script>
		jQuery(document).ready(function () {
			App.init();
		});
	</script>
</body>
<!-- END BODY -->
</html>
