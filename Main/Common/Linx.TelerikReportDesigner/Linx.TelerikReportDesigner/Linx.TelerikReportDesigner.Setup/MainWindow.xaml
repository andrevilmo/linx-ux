<Window x:Class="Linx.TelerikReportDesigner.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linx Report" Height="350" Width="525" ResizeMode="CanMinimize" >
    <Grid>
        <Button x:Name="btnInstall" Content="Instalar" HorizontalAlignment="Left" Margin="344,282,0,0" VerticalAlignment="Top" Width="75" Click="BtnInstall_Click"/>
        <Button x:Name="btnCancel" Content="Cancelar" HorizontalAlignment="Left" Margin="424,282,0,0" VerticalAlignment="Top" Width="75" Click="BtnCancel_Click"/>
        <Label Content="Telerik Report Designer" HorizontalAlignment="Left" Margin="232,92,0,0" VerticalAlignment="Top" />
        <Label Content="Linx Report" HorizontalAlignment="Left" Margin="232,123,0,0" VerticalAlignment="Top" Width="160" />
        <Label Content="Publish Report" HorizontalAlignment="Left" Margin="232,154,0,0" VerticalAlignment="Top" Width="160" />
        <DockPanel HorizontalAlignment="Left" Height="292" LastChildFill="False" Margin="10,10,0,0" VerticalAlignment="Top" Width="210" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <TextBlock Height="290" Padding="5,10,5,10" TextWrapping="Wrap" VerticalAlignment="Top" Width="209" Name="txbLog" RenderTransformOrigin="0.5,0.5" >
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="-1"/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
            </TextBlock>
        </DockPanel>
        <Label HorizontalAlignment="Left" Height="40" Margin="250,10,0,0" Content="Linx Report Installer" VerticalAlignment="Top" Width="232" FontSize="20" FontWeight="Bold" BorderThickness="0"/>
        <TextBlock HorizontalAlignment="Left" Margin="232,68,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Height="30" Width="250">
            <TextBlock.Text>Abaixo os itens a serem instalados:</TextBlock.Text>
        </TextBlock>
        <ProgressBar Name="pbInstall" Visibility="Hidden" HorizontalAlignment="Left" Height="17" Margin="235,216,0,0" VerticalAlignment="Top" Width="264"/>
        <Button x:Name="btnClose" Content="Fechar" Visibility="Hidden" HorizontalAlignment="Left" Margin="424,282,0,0" VerticalAlignment="Top" Width="75" Click="BtnClose_Click"/>
    </Grid>
</Window>
