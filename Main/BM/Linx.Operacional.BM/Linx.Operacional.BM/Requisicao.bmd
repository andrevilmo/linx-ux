        <modelAttribute Id="d4e9ae76-c9b9-4b4c-b457-e3d66e1f4cfa" name="LX_FATOR_STK_MOV_QTDE" description="Fator que será multiplicado pela quantidade do Item da Nota para movimentação do Estoque.&#xA;&#xA;Pode ser 0, 1 ou -1.&#xA;&#xA;Normalmente é:&#xA;. 1 para entradas&#xA;. -1 para saídas e&#xA;. 0 para entradas ou saídas complementares.&#xA;&#xA;Irá como sugestão no Movimento do Estoque " dataType="Short" isPrimaryKey="false" isIdentity="false" isNullable="false" precision="0" scale="0" domainName="LX_FATOR_STK_MOV" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="a56b7e4b-3e95-445f-9369-a4b7b5267bd6" name="LX_FATOR_STK_MOV_VALOR" description="Fator que será multiplicado pelo Valor do Item da Nota para movimentação do Estoque.&#xA;&#xA;Pode ser 0, 1 ou -1.&#xA;&#xA;Normalmente é:&#xA;. 1 para entradas&#xA;. -1 para saídas&#xA;&#xA;Irá como sugestão no Movimento do Estoque " dataType="Short" isPrimaryKey="false" isIdentity="false" isNullable="false" precision="0" scale="0" domainName="LX_FATOR_STK_MOV" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
