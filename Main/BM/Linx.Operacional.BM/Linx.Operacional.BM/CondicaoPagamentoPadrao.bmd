        <modelAttribute Id="b21279b2-82ff-4739-a049-7ef5a9ab1157" name="DIA_FIXO_2" description="Dia 2 fixo do mês para vencimento, sempre em conjunto com o DIA_FIXO_1. Ex: &#xA;DIA_FIXO_1 = 10&#xA;DIA_FIXO_2 = 20&#xA;&#xA;O vencimento deve cair sempre nestes dias, o que for mais próximo. &#xA;Se o vencimento cai no dia 12, então é 10,&#xA;Se o vencimento cai no dia 16, então é 20. " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
