        <modelAttribute Id="6cdb1ef1-c5ff-4059-bdb0-9a5446a48e5b" name="DIA_FIXO_2" description="Dia 2 fixo do mês para vencimento, sempre em conjunto com o DIA_FIXO_1. Ex: &#xA;DIA_FIXO_1 = 10&#xA;DIA_FIXO_2 = 20&#xA;&#xA;O vencimento deve cair sempre nestes dias, o que for mais próximo. &#xA;Se o vencimento cai no dia 12, então é 10,&#xA;Se o vencimento cai no dia 16, então é 20. " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="6459d226-aef2-45e2-930b-d3f892673d22" name="DIA_FIXO_SEMANA_1" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
