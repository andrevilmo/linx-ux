        <modelAttribute Id="b8bef5e4-2ee2-4853-b266-7e00bef7b0a1" name="DIAS_MEDIO" description="Dias Médio de Vencimento.&#xA;&#xA;Se parcela única, igual a DIAS_VENCIMENTO&#xA;Se múltiplas parcelas, igual a:&#xA;&#xA;dias X número da parcela    =&#xA;30 x 1 =   30&#xA;30 x 2 =   60&#xA;30 x 3 =   90&#xA;30 x 4 =  120&#xA;               ----&#xA;               300  /  4 = 75 " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
