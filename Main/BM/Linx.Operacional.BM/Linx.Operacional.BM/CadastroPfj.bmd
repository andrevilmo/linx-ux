    <referenceModelClass Id="6045255d-164e-4529-9378-cc89a11e9f25" name="LCF_INDICADOR_FISCAL_PFJ" description="Planilha UX-FIS-001 - Tabela fixa Linx, contendo os indicadores &#xA;que serão atribuídos às Pessoas Físicas ou Jurídicas (Terceiros) &#xA;e serão utilizados para determinação do CFOP, Regras de Impostos&#xA; e como auxiliar para determinação das Contas Contábeis.&#xA;&#xA;10 - Empresa Industrial e Comercial&#xA;11 - Empresa Comercial&#xA;12 - Empresa Comercial, equiparada à Indústria&#xA;20 - Distribuidora de Energia Elétrica&#xA;21 - Empresa de Comunicação&#xA;22 - Empresa de Transporte&#xA;30 - Produtor rural&#xA;40 - Comercial Importadora ou Exportadora&#xA;50 - Prestador de Serviços - ISSQN&#xA;60 - Ambulante&#xA;90 - Armazém geral / depósito&#xA;91 - Feira / Exposição / Bazar&#xA;99 - Pessoa Física" table="LCF_INDICADOR_FISCAL_PFJ" schema="LX_LCF" primaryKeyConstraintName="XPK_LCF_INDICADOR_FISCAL_PFJ" notMapped="false" hideAssociations="false" isDimensionFilter="true" isReadOnly="false" inStudy="false" isValidatable="false" modelViewAggregation="false" enableCache="false" modelViewDistinct="false" modelViewCustomQueryEnabled="false" modelClassReference="modelbus://Linx.BusinessModelDesigner.BusinessModelDesignerAdapter/PFJ/LCF_INDICADOR_FISCAL_PFJ/..\..\Linx.CadastroBase.BM\Linx.CadastroBase.BM\PFJ.bmd%2f6d8f3beb-98a1-43c6-8e33-cda2de161043" hasReferenceError="false">
