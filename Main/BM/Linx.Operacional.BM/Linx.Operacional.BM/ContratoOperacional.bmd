        <modelAttribute Id="6a3db5f2-f6c6-499f-9aa3-38670c8d097e" name="DIA_FIXO_SEMANA_2" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="7a8cd2dd-7169-4f18-9b83-0db4d007699b" name="DIAS_MEDIO" description="Dias Médio de Vencimento.&#xA;&#xA;Se parcela única, igual a DIAS_VENCIMENTO&#xA;Se múltiplas parcelas, igual a:&#xA;&#xA;dias X número da parcela    =&#xA;30 x 1 =   30&#xA;30 x 2 =   60&#xA;30 x 3 =   90&#xA;30 x 4 =  120&#xA;               ----&#xA;               300  /  4 = 75 " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
