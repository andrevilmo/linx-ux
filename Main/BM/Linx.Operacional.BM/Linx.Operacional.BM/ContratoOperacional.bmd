    <referenceModelClass Id="f75b1ba0-838f-4e01-9ba5-b7a9704b6b84" name="LNF_CONDICAO_PAGAMENTO_PARCELA" description="Gerado somente quando as parcelas forem por dias ou porcentagem variável.&#xA;&#xA;Parc.&#x9;Dias&#x9;%&#x9;&#x9;subtotal&#x9;&#xA;1&#x9;30     x&#x9;60   =&#x9;&#x9;1800&#x9;&#xA;1&#x9;60     x&#x9;40   =&#x9;&#x9;2400&#x9;&#xA;1&#x9;90     x&#x9;30   =&#x9;&#x9;2700&#x9;&#xA;1&#x9;120   x&#x9;20   =&#x9;&#x9;2400&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;4&#x9;300&#x9;150&#x9;&#x9;9300&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;Média&#x9;300/4 = 75                          9300/150 = 62&#x9;&#xA;&#x9;      Fixa&#x9;&#x9;&#x9;Váriavel&#x9;&#xA;" schema="LX_LNF" notMapped="false" hideAssociations="false" isDimensionFilter="false" isReadOnly="false" inStudy="false" isValidatable="false" modelViewAggregation="false" enableCache="false" modelViewDistinct="false" modelViewCustomQueryEnabled="false" modelClassReference="modelbus://Linx.BusinessModelDesigner.BusinessModelDesignerAdapter/CondicaoPagamentoPadrao/LNF_CONDICAO_PAGAMENTO_PARCELA/.\CondicaoPagamentoPadrao.bmd%2f23dcf8ab-ef8f-4314-b83e-05b9dc24ccb6" hasReferenceError="false">
