    <referenceModelClass Id="dfccc216-166b-4687-b5c0-694ecb4ee259" name="LCF_IMPOSTO_MODALIDADE_BASE" description="Modalidade de determinação da Base de Cálculo do Imposto&#xA;&#xA;ICMS&#xA;0 - Margem Valor Agregado (%);&#xA;1 - Pauta (Valor);&#xA;2 - Preço Tabelado Máx. (valor);&#xA;3 - Valor da operação.&#xA;&#xA;ICMS-ST&#xA;0 - Preço tabelado ou máximo sugerido;&#xA;1 - Lista Negativa (valor);&#xA;2 - Lista Positiva (valor);&#xA;3 - Lista Neutra (valor);&#xA;4 - Margem Valor Agregado (%);&#xA;5 - Pauta (valor);&#xA;&#xA;PIS:&#xA;1 - Valor da operação alíquota normal (cumulativo/não cumulativo);&#xA;2 - Valor da operação (alíquota diferenciada);&#xA;3 - Quantidade vendida x alíquota por unidade de produto;&#xA;&#xA;COFINS:&#xA;1 - Valor da operação alíquota normal (cumulativo/não cumulativo);&#xA;2 - Valor da operação (alíquota diferenciada);&#xA;3 - Quantidade vendida x alíquota por unidade de produto;" table="LCF_IMPOSTO_MODALIDADE_BASE" schema="LX_LCF" primaryKeyConstraintName="XPK_LCF_IMPOSTO_MODALIDADE_BASE" notMapped="false" hideAssociations="false" isDimensionFilter="true" isReadOnly="false" inStudy="false" isValidatable="false" modelViewAggregation="false" enableCache="false" modelViewDistinct="false" modelViewCustomQueryEnabled="false" modelClassReference="modelbus://Linx.BusinessModelDesigner.BusinessModelDesignerAdapter/Imposto/LCF_IMPOSTO_MODALIDADE_BASE/..\..\Linx.Federado.BM\Linx.Federado.BM\Imposto.bmd%2f16c6ff67-a316-4572-a20c-bc43d13007c7" hasReferenceError="false">
