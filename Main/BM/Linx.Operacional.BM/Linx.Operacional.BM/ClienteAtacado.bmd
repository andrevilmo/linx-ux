        <modelAttribute Id="36502b5c-1952-41f1-9809-0582d575899e" name="DIA_FIXO_1" description="Dia fixo do mês para vencimento. Ex: Vence todo dia 15." dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="230cff3e-6574-4ab3-9981-d09cdc831b00" name="DIA_FIXO_2" description="Dia 2 fixo do mês para vencimento, sempre em conjunto com o DIA_FIXO_1. Ex: &#xA;DIA_FIXO_1 = 10&#xA;DIA_FIXO_2 = 20&#xA;&#xA;O vencimento deve cair sempre nestes dias, o que for mais próximo. &#xA;Se o vencimento cai no dia 12, então é 10,&#xA;Se o vencimento cai no dia 16, então é 20. " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="0eea0de3-06e0-4d3d-a4a3-d4aa2db7ae18" name="DIA_FIXO_SEMANA_1" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="09316a12-6d07-4d40-be2a-40e8df3a5bee" name="DIA_FIXO_SEMANA_2" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="27731849-41f2-4b32-96b2-9326ac49c4b5" name="DIAS_MEDIO" description="Dias Médio de Vencimento.&#xA;&#xA;Se parcela única, igual a DIAS_VENCIMENTO&#xA;Se múltiplas parcelas, igual a:&#xA;&#xA;dias X número da parcela    =&#xA;30 x 1 =   30&#xA;30 x 2 =   60&#xA;30 x 3 =   90&#xA;30 x 4 =  120&#xA;               ----&#xA;               300  /  4 = 75 " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
