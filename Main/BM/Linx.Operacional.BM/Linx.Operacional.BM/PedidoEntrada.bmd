    <referenceModelClass Id="c5c10a86-39fa-45a0-bc5e-36422e2da87f" name="LCF_FINALIDADE" description="Planilha UX-STK-001 - Condição de Estocagem (tabela fixa Linx) - Define a Condição de Estocagem na Empresa ou em terceiros, Ex: &#xA;&#xA;Propriedade - 1 - PRÓPRIO&#xA;100 - Estoque Próprio&#xA;110 - Estoque Próprio sob Regime DRAWBACK&#xA;152 - Consig.Indl dev.simb.aguardando venda&#xA;162 - Consig.Merc dev.simb.aguardando venda&#xA;&#xA;Propriedade - 2 - DE TERCEIROS&#xA;200 - para Venda Fora Estabelecimento&#xA;201 - em Demonstração&#xA;202 - para uso fora do estabelecimento (ativos)&#xA;203 - para em comodato (ativos)&#xA;&#xA;Propriedade - 3 - PRÓPRIO COM TERCEIROS&#xA;300 - para Venda Fora Estabelecimento&#xA;301 - para Demonstração&#xA;302 - para uso fora do estabelecimento (ativos)&#xA;303 - para em comodato (ativos)&#xA;304 - para Amostra&#xA;&#xA;Propriedade - 4 - DE TERCEIROS COM TERCEIROS&#xA;400 - para Venda Fora Estabelecimento&#xA;401 - para Demonstração&#xA;402 - para uso fora do estabelecimento (ativos)&#xA;403 - para em comodato (ativos)&#xA;404 - para Amostra&#xA;&#xA;etc..." table="LCF_FINALIDADE" schema="LX_LCF" primaryKeyConstraintName="XPK_LCF_FINALIDADE" notMapped="false" hideAssociations="false" isDimensionFilter="true" isReadOnly="false" inStudy="false" isValidatable="false" modelViewAggregation="false" enableCache="false" modelViewDistinct="false" modelViewCustomQueryEnabled="false" modelClassReference="modelbus://Linx.BusinessModelDesigner.BusinessModelDesignerAdapter/OperacaoFiltro/LCF_FINALIDADE/.\OperacaoFiltro.bmd%2fdc59cabd-e229-4527-9131-20181a778fb8" hasReferenceError="false">
