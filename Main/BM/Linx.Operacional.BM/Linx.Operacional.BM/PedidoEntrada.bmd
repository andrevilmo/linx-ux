        <modelAttribute Id="163fe755-291d-4fba-a95d-976f8af1547c" name="DIA_FIXO_1" description="Dia fixo do mês para vencimento. Ex: Vence todo dia 15." dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="7132106d-320b-4b15-85a2-7a6032faa2d0" name="DIA_FIXO_2" description="Dia 2 fixo do mês para vencimento, sempre em conjunto com o DIA_FIXO_1. Ex: &#xA;DIA_FIXO_1 = 10&#xA;DIA_FIXO_2 = 20&#xA;&#xA;O vencimento deve cair sempre nestes dias, o que for mais próximo. &#xA;Se o vencimento cai no dia 12, então é 10,&#xA;Se o vencimento cai no dia 16, então é 20. " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="b0f844dc-33ab-40a9-a52f-0b6c489e6a72" name="DIA_FIXO_SEMANA_1" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="7546eb0b-63e3-4624-8308-fbaa1ac550df" name="DIA_FIXO_SEMANA_2" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="ccba641c-64b5-47f8-8797-22600e002406" name="DIAS_MEDIO" description="Dias Médio de Vencimento.&#xA;&#xA;Se parcela única, igual a DIAS_VENCIMENTO&#xA;Se múltiplas parcelas, igual a:&#xA;&#xA;dias X número da parcela    =&#xA;30 x 1 =   30&#xA;30 x 2 =   60&#xA;30 x 3 =   90&#xA;30 x 4 =  120&#xA;               ----&#xA;               300  /  4 = 75 " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
        <modelAttribute Id="3162edc2-9fa3-417b-895c-73419cd37706" name="DIAS_DESCONTO_VENCTO" description="Quantidade de dias para desconto de antecipação. Ex. Se pagar até 10 dias antes do vencimento, tem desconto de 1%. " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" brandDecimalsControl="false" />
