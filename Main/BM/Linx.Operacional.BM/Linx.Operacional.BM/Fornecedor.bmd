        <modelAttribute Id="0c9746de-4243-4d17-969f-bae74007fee5" name="DIA_FIXO_1" description="Dia fixo do mês para vencimento. Ex: Vence todo dia 15." dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="b6fa858d-f6da-49a6-aa9d-798f782ee171" name="DIA_FIXO_2" description="Dia 2 fixo do mês para vencimento, sempre em conjunto com o DIA_FIXO_1. Ex: &#xA;DIA_FIXO_1 = 10&#xA;DIA_FIXO_2 = 20&#xA;&#xA;O vencimento deve cair sempre nestes dias, o que for mais próximo. &#xA;Se o vencimento cai no dia 12, então é 10,&#xA;Se o vencimento cai no dia 16, então é 20. " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="146c96f6-c004-41f8-b218-16067922114f" name="DIA_FIXO_SEMANA_1" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="8e519f64-b63d-4db5-b811-9e0a12d1f7be" name="DIA_FIXO_SEMANA_2" description="Dia da semana que deve cair o vencimento. Ex:&#xA;Vencimento somente às 2as. ou 6as. feiras&#xA;DIA_FIXO_SEMANA_1 = 2&#xA;DIA_FIXO_SEMANA_2 = 6" dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" sqlDefault="((0))" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
        <modelAttribute Id="21de62f0-1a89-4ec8-a913-7444aaca6eb6" name="DIAS_MEDIO" description="Dias Médio de Vencimento.&#xA;&#xA;Se parcela única, igual a DIAS_VENCIMENTO&#xA;Se múltiplas parcelas, igual a:&#xA;&#xA;dias X número da parcela    =&#xA;30 x 1 =   30&#xA;30 x 2 =   60&#xA;30 x 3 =   90&#xA;30 x 4 =  120&#xA;               ----&#xA;               300  /  4 = 75 " dataType="Int" isPrimaryKey="false" isIdentity="false" precision="10" scale="0" notMapped="false" isComputed="false" isDimensionFilterSuggestion="false" isCustomized="false" filteringDisabled="false" isUniqueValue="false" />
