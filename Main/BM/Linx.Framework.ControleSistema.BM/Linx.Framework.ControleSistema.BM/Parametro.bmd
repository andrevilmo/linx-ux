<businessModelDesignerRoot xmlns:dm0="http://schemas.microsoft.com/VisualStudio/2008/DslTools/Core" dslVersion="1.0.0.0" Id="1813d1bf-c01c-45e0-9768-d7824b4ff384" name="" documentName="Parametro.bmd" targetNamespace="Linx.Framework.ControleSistema.BM" documentPath="C:\Linx Workspace\Linx\Linx UX\Dev\5.X\BM\Linx.Framework.ControleSistema.BM\Linx.Framework.ControleSistema.BM" noCode="false" removeAutomaticIndexes="false" removeRequiredAttributes="false" setIdLinxWithIdGpecon="false" forceDynamicForeignKeyNames="false" xmlns="http://schemas.microsoft.com/dsltools/BusinessModelDesigner">
  <comments>
    <comment Id="f309bd80-b7a9-4212-926e-f88f372ee77b" text="--Constraint para validação de parâmetros com variação&#xA;&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.check_constraints WHERE object_id = OBJECT_ID(N'[LX_TCS].[CK_UID_TABELA_CHAVE_SELECAO]') AND parent_object_id = OBJECT_ID(N'[LX_TCS].[TCS_PARAMETRO_VALOR]'))&#xA;BEGIN&#xA;    PRINT 'ALTER TABLE [LX_TCS].[TCS_PARAMETRO_VALOR] DROP CONSTRAINT [CK_UID_TABELA_CHAVE_SELECAO]'&#xA;    ALTER TABLE [LX_TCS].[TCS_PARAMETRO_VALOR] DROP CONSTRAINT [CK_UID_TABELA_CHAVE_SELECAO]&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT * FROM sys.check_constraints WHERE object_id = OBJECT_ID(N'[LX_TCS].[CK_UID_TABELA_CHAVE_SELECAO]') AND parent_object_id = OBJECT_ID(N'[LX_TCS].[TCS_PARAMETRO_VALOR]'))&#xA;BEGIN&#xA;    PRINT 'ALTER TABLE [LX_TCS].[TCS_PARAMETRO_VALOR] WITH CHECK ADD CONSTRAINT [CK_UID_TABELA_CHAVE_SELECAO]'&#xA;    ALTER TABLE [LX_TCS].[TCS_PARAMETRO_VALOR] WITH CHECK&#xA;    ADD CONSTRAINT [CK_UID_TABELA_CHAVE_SELECAO] CHECK (    ([UID_TABELA] IS     NULL and [CHAVE_SELECAO] IS     NULL and [POSSUI_VARIACAO] = 0 )&#xA;                                                         OR ([UID_TABELA] IS NOT NULL and [CHAVE_SELECAO] IS NOT NULL and [POSSUI_VARIACAO] = 1 ) )&#xA;END&#xA;&#xA;IF  EXISTS (SELECT * FROM sys.check_constraints WHERE object_id = OBJECT_ID(N'[LX_TCS].[CK_UID_TABELA_CHAVE_SELECAO]') AND parent_object_id = OBJECT_ID(N'[LX_TCS].[TCS_PARAMETRO_VALOR]'))&#xA;BEGIN&#xA;    PRINT 'ALTER TABLE [LX_TCS].[TCS_PARAMETRO_VALOR] CHECK CONSTRAINT [CK_UID_TABELA_CHAVE_SELECAO]'&#xA;    ALTER TABLE [LX_TCS].[TCS_PARAMETRO_VALOR] CHECK CONSTRAINT [CK_UID_TABELA_CHAVE_SELECAO]&#xA;END" />
  </comments>
