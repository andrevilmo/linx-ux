<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='Autorizacao.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot0" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='Mensagem.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot1" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='Multimidia.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot2" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='Orquestrador.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot3" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='Parametro.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot4" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='TransacaoModulo.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot5" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='TratamentoErros.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot6" #>
	<#@ BusinessModelDesigner processor="BusinessModelDesignerDirectiveProcessor" requires="fileName='UsuarioGpecon.bmd'" provides="BusinessModelDesignerRoot=BusinessModelDesignerRoot7" #>
	
<#@ import namespace = "System.Collections.Generic" #>
<#+
private  List<BusinessModelDesignerRoot> GetModels()
{
  List<BusinessModelDesignerRoot> models = new List<BusinessModelDesignerRoot>();
  //Add Models	

	if (!this.BusinessModelDesignerRoot0.NoCode)
		models.Add(this.BusinessModelDesignerRoot0);
		if (!this.BusinessModelDesignerRoot1.NoCode)
		models.Add(this.BusinessModelDesignerRoot1);
		if (!this.BusinessModelDesignerRoot2.NoCode)
		models.Add(this.BusinessModelDesignerRoot2);
		if (!this.BusinessModelDesignerRoot3.NoCode)
		models.Add(this.BusinessModelDesignerRoot3);
		if (!this.BusinessModelDesignerRoot4.NoCode)
		models.Add(this.BusinessModelDesignerRoot4);
		if (!this.BusinessModelDesignerRoot5.NoCode)
		models.Add(this.BusinessModelDesignerRoot5);
		if (!this.BusinessModelDesignerRoot6.NoCode)
		models.Add(this.BusinessModelDesignerRoot6);
		if (!this.BusinessModelDesignerRoot7.NoCode)
		models.Add(this.BusinessModelDesignerRoot7);
	
  return models;
}
#>