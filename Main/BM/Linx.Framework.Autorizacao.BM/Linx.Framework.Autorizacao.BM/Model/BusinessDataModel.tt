                    System.Data.SQLite.SQLiteException sqliteExcep = null;
                    if (commitException is System.Data.SQLite.SQLiteException)
                        sqliteExcep = (System.Data.SQLite.SQLiteException)commitException;
                    else if (commitException.InnerException != null && commitException.InnerException is System.Data.SQLite.SQLiteException)
                        sqliteExcep = (System.Data.SQLite.SQLiteException)commitException.InnerException;


                    if (sqliteExcep != null && sqliteExcep.ErrorCode == 5)  //Database locked
                    {
                        return SaveChanges();
                    }
                    else
                        throw commitException;                    
                }

<#
		}
