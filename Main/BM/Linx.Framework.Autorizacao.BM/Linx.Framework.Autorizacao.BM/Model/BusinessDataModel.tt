		#region Batch Maintenance

		public List<EntityFramework.Utilities.WarningResult<T>> UpdateAll<T>(IEnumerable<T> entities, List<EntityFramework.Utilities.ForeignKeyCfg> fkCfgs, string[] businessKeys, EntityFramework.Utilities.ScriptEvent scriptEvent, string deletedPropertyName, params System.Linq.Expressions.Expression<Func<T, object>>[] columns) where T : class
        {
            List<EntityFramework.Utilities.WarningResult<T>> result = null;
            IDbSet<T> set = this.GetPropertyValue(typeof(T).Name) as IDbSet<T>;

            if (set != null)
            {
                Action<EntityFramework.Utilities.UpdateSpecification<T>> updateSpecification = p => p.ColumnsToUpdate(columns);
                result = EntityFramework.Utilities.EFBatchOperation.For(this, set).UpdateAll(entities, updateSpecification, fkCfgs, businessKeys, scriptEvent, deletedPropertyName);
            }

            return result;
        }

        public IEnumerable<T> InsertAll<T>(IEnumerable<T> entities) where T : class
        {
            IDbSet<T> set = this.GetPropertyValue(typeof(T).Name) as IDbSet<T>;

            if (set != null)
                EntityFramework.Utilities.EFBatchOperation.For(this, set).InsertAll(entities);

            return entities;
        }

        public int DeleteAll<T>(System.Linq.Expressions.Expression<Func<T, bool>> filter) where T : class
        {
            IDbSet<T> set = this.GetPropertyValue(typeof(T).Name) as IDbSet<T>;

            int count = 0;
            if (set != null)
                 count = EntityFramework.Utilities.EFBatchOperation.For<<#=rootDesigner.DataContextName#>, T>(this, set).Where(filter).Delete();

            return count;
        }

		#endregion Batch Maintenance

