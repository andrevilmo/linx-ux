		private void StartConfigurations()
		{			
			//Configuring log command report
			//Hot Tip:
			//For generating the SQL script to output window, use the following command: this.Database.Log = s => System.Diagnostics.Debug.WriteLine(s);
            this.Database.Log = s => { };
            System.Diagnostics.StackFrame frame = new System.Diagnostics.StackFrame(2);
            if (frame != null)
            {
                var method = frame.GetMethod();
                if (method != null)
                {
                    this.CallerName = method.DeclaringType.Name + "(" + method.DeclaringType.Assembly.FullName + ")";
                }
            }
            ///////////////////////////////

            // Load navigation properties explicitly
            this.Configuration.LazyLoadingEnabled = true;
            // Enable entity validation
            this.Configuration.ValidateOnSaveEnabled = true;
			// Performance improvements by turning off detection of changes
            this.Configuration.AutoDetectChangesEnabled = false;

<#
	  if (defaultProvider == Provider.SQLServer)
	  {
#>
            // Adjust default transaction isolation level as "Read Uncommited"
            this.Database.ExecuteSqlCommand("SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED");            
<#
	  }
#>

		}

