#>		
		public bool HasAuditEntity(string fullName) 
		{
			if (!this.AuditEntities.Contains(fullName)) return false;
            var tableAttr = Type.GetType(fullName).GetCustomAttribute<TableAttribute>();
            var auditAttr = Type.GetType(fullName).GetCustomAttribute<AuditAttribute>();

            if (SecurityHelper == null || tableAttr == null)
                return false;
            if (SecurityHelper.GetAuditIgnoredSchemas(this.IdLinx).Contains(tableAttr.Schema, StringComparer.InvariantCultureIgnoreCase) || 
                SecurityHelper.GetAuditIgnoredTables(this.IdLinx).Contains(tableAttr.Schema + "." + tableAttr.Name, StringComparer.InvariantCultureIgnoreCase))
                return false;
            if (auditAttr.AuditType == AuditType.SelectedColumns && (auditAttr.Columns == null || auditAttr.Columns.Length == 0))
                return false;


            return true;
        }
<#
		}			
#>


