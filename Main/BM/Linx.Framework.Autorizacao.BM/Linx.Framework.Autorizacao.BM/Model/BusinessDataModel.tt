				catch (System.Data.Entity.Validation.DbEntityValidationException dbValidationException)
				{
					string message = string.Empty;
					foreach (var validation in dbValidationException.EntityValidationErrors)
					{
                        message += string.Format("A entidade \"{0}\" cancelou o processo com o(s) seguinte(s) aviso(s):", validation.Entry.Entity.GetType().Name);
                        foreach (var validationError in validation.ValidationErrors)
                            message += string.Format("\r\n -{0} {1}", (validationError.PropertyName.IsNullOrEmpty() ? "" :  " Propriedade [" + validationError.PropertyName + "]:"), validationError.ErrorMessage);
					}
                    throw new Exception(message);
				}
                catch (System.Data.Entity.Infrastructure.DbUpdateException dbUpdateException)
                {
                    if (dbUpdateException.InnerException.InnerException is System.Data.SqlClient.SqlException)
                        throw Linx.Tools.LinxSqlErrors.SqlException((System.Data.SqlClient.SqlException)dbUpdateException.InnerException.InnerException, this.GetConstraintDescriptors());
                    else
