+$serviceMap = [ordered]@{
+    'Linx.Tools.dll'                        = @(
+        (Join-Path $workspace 'Common\Linx.Tools.Library\Desktop\Linx.Desktop.Tools\bin\Release\Linx.Tools.dll')
