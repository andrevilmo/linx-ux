  "item": [
    {
      "name": "Admin MFA PDV",
      "description": "Fluxo recomendado para vendedor: status → revogar → status de novo.\n\nPreencha `idGpecon` (ID_LINX) e `idUserMfa` (ID_VENDEDOR).",
      "item": [
        {
          "name": "1. GetMfaStatus (antes)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "AuthorizationToken",
                "value": "{{authorizationToken}}",
                "type": "text"
              },
              {
                "key": "CurrentUser",
                "value": "{{currentUser}}",
                "type": "text"
              },
              {
                "key": "Environment",
                "value": "{{environment}}",
                "type": "text"
              },
              {
                "key": "Application",
                "value": "{{application}}",
                "type": "text"
              },
              {
                "key": "CurrentCompany",
                "value": "{{currentCompany}}",
                "type": "text"
              },
              {
                "key": "AccessGroup",
                "value": "{{accessGroup}}",
                "type": "text"
              },
              {
                "key": "EconomicGroup",
                "value": "{{economicGroup}}",
                "type": "text"
              },
              {
                "key": "SessionID",
                "value": "{{sessionId}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{serviceUrl}}/LinxFrameworkAutorizacao/GetMfaStatus?tableOrigin={{tableOrigin}}&idGpecon={{idGpecon}}&idUserMfa={{idUserMfa}}",
              "host": [
                "{{serviceUrl}}"
              ],
              "path": [
                "LinxFrameworkAutorizacao",
                "GetMfaStatus"
              ],
              "query": [
                {
                  "key": "tableOrigin",
                  "value": "{{tableOrigin}}",
                  "description": "PDV ou alias LJV_VENDEDOR"
                },
                {
                  "key": "idGpecon",
                  "value": "{{idGpecon}}",
                  "description": "ID_LINX — obrigatório explícito no PDV"
                },
                {
                  "key": "idUserMfa",
                  "value": "{{idUserMfa}}",
                  "description": "LJV_VENDEDOR.ID_VENDEDOR"
                }
              ]
            },
            "description": "Consulta se o **vendedor** tem MFA cadastrado (`Enrolled` / `CanRevoke`).\n\n`tableOrigin=PDV` → chave `(PDV, idGpecon, idUserMfa=ID_VENDEDOR)`.\n\nNão envie `uidUsuario` (Guid UX): `LoadUxUser` não resolve origem PDV."
          },
          "response": [
            {
              "name": "Exemplo — enrolled (PDV)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"TableOrigin\": \"PDV\",\n  \"IdGpecon\": 123,\n  \"IdUserMfa\": 456,\n  \"UidUsuario\": null,\n  \"NomeAutenticacao\": null,\n  \"Enrolled\": true,\n  \"CanRevoke\": true,\n  \"RequiresMfa\": true,\n  \"MfaLocked\": false,\n  \"CompanyMfaEnabled\": true,\n  \"UserUtilizaMfa\": true,\n  \"SkipReason\": null\n}"
            }
          ]
        },
        {
          "name": "2. RevokeMfaSecret",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "AuthorizationToken",
                "value": "{{authorizationToken}}",
                "type": "text"
              },
              {
                "key": "CurrentUser",
                "value": "{{currentUser}}",
                "type": "text"
              },
              {
                "key": "Environment",
                "value": "{{environment}}",
                "type": "text"
              },
              {
