              "body": "{\n  \"TableOrigin\": \"PDV\",\n  \"IdGpecon\": 123,\n  \"IdUserMfa\": 456,\n  \"Enrolled\": false,\n  \"CanRevoke\": false,\n  \"RequiresMfa\": true,\n  \"MfaLocked\": false\n}"
            }
