                "type": "text"
              },
              {
                "key": "AccessGroup",
                "value": "{{accessGroup}}",
                "type": "text"
              },
              {
                "key": "EconomicGroup",
                "value": "{{economicGroup}}",
                "type": "text"
              },
              {
                "key": "SessionID",
                "value": "{{sessionId}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{serviceUrl}}/LinxFrameworkAutorizacao/RevokeMfaSecret?tableOrigin={{tableOrigin}}&idGpecon={{idGpecon}}&idUserMfa={{idUserMfa}}",
              "host": [
                "{{serviceUrl}}"
              ],
              "path": [
                "LinxFrameworkAutorizacao",
                "RevokeMfaSecret"
              ],
              "query": [
                {
                  "key": "tableOrigin",
                  "value": "{{tableOrigin}}",
                  "description": "PDV ou alias LJV_VENDEDOR"
                },
                {
                  "key": "idGpecon",
                  "value": "{{idGpecon}}",
                  "description": "ID_LINX — obrigatório explícito no PDV"
                },
                {
                  "key": "idUserMfa",
                  "value": "{{idUserMfa}}",
                  "description": "LJV_VENDEDOR.ID_VENDEDOR"
                }
              ]
            },
            "description": "Revoga o ACCESS_SECRET MFA do **vendedor**.\n\nEfeitos (chave TABLE_ORIGIN=PDV):\n- UPDATE TCS_USUARIO_MFA: ATIVO=0, ACCESS_SECRET=NULL, limpa lockout TOTP\n- DELETE TCS_USUARIO_MFA_DISPOSITIVO\n- Auditoria tipo R / canal MFA-Admin\n\nNão emite ticket MFA. Não altera MFA do usuário UX.\n\nMétodo: GET (não POST).\n\nNão há botão Revogar MFA na UI LojaVendedor nesta entrega."
          },
          "response": [
            {
              "name": "Exemplo — sucesso",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"Success\": true,\n  \"Message\": \"MFA revogado. O usuário cadastrará um novo QR no próximo acesso.\",\n  \"Ticket\": null,\n  \"TicketExpiresUtc\": null,\n  \"MfaLocked\": false\n}"
            },
            {
              "name": "Exemplo — usuário não informado",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"Success\": false,\n  \"Message\": \"Usuário MFA não informado.\",\n  \"Ticket\": null,\n  \"TicketExpiresUtc\": null,\n  \"MfaLocked\": false\n}"
            }
          ]
        },
