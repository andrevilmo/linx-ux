  "item": [
    {
      "name": "Admin MFA",
      "description": "Fluxo recomendado: status → revogar → status de novo.",
      "item": [
        {
          "name": "1. GetMfaStatus (antes)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "AuthorizationToken",
                "value": "{{authorizationToken}}",
                "type": "text"
              },
              {
                "key": "CurrentUser",
                "value": "{{currentUser}}",
                "type": "text"
              },
              {
                "key": "Environment",
                "value": "{{environment}}",
                "type": "text"
              },
              {
                "key": "Application",
                "value": "{{application}}",
                "type": "text"
              },
              {
                "key": "CurrentCompany",
                "value": "{{currentCompany}}",
                "type": "text"
              },
              {
                "key": "AccessGroup",
                "value": "{{accessGroup}}",
                "type": "text"
              },
              {
                "key": "EconomicGroup",
                "value": "{{economicGroup}}",
                "type": "text"
              },
              {
                "key": "SessionID",
                "value": "{{sessionId}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{serviceUrl}}/LinxFrameworkAutorizacao/GetMfaStatus?tableOrigin={{tableOrigin}}&idGpecon={{idGpecon}}&uidUsuario={{uidUsuario}}&idUserMfa={{idUserMfa}}",
              "host": [
                "{{serviceUrl}}"
              ],
              "path": [
                "LinxFrameworkAutorizacao",
                "GetMfaStatus"
              ],
              "query": [
                {
                  "key": "tableOrigin",
                  "value": "{{tableOrigin}}"
                },
                {
                  "key": "idGpecon",
                  "value": "{{idGpecon}}"
                },
                {
                  "key": "uidUsuario",
                  "value": "{{uidUsuario}}"
                },
                {
                  "key": "idUserMfa",
                  "value": "{{idUserMfa}}",
                  "description": "Opcional se uidUsuario estiver preenchido"
                }
              ]
            },
            "description": "Consulta se o usuário tem MFA cadastrado (`Enrolled` / `CanRevoke`).\n\nCom `uidUsuario` e `idGpecon=0`, o Service resolve GPECON e ID_USUARIO do cadastro UX."
          },
          "response": [
            {
              "name": "Exemplo — enrolled",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"TableOrigin\": \"UX\",\n  \"IdGpecon\": 123,\n  \"IdUserMfa\": 456,\n  \"UidUsuario\": \"11111111-2222-3333-4444-555555555555\",\n  \"NomeAutenticacao\": \"usuario.demo\",\n  \"Enrolled\": true,\n  \"CanRevoke\": true,\n  \"RequiresMfa\": true,\n  \"MfaLocked\": false,\n  \"CompanyMfaEnabled\": true,\n  \"UserUtilizaMfa\": true,\n  \"SkipReason\": null\n}"
            }
          ]
        },
        {
          "name": "2. RevokeMfaSecret",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "AuthorizationToken",
                "value": "{{authorizationToken}}",
                "type": "text"
              },
              {
                "key": "CurrentUser",
                "value": "{{currentUser}}",
                "type": "text"
              },
              {
                "key": "Environment",
                "value": "{{environment}}",
                "type": "text"
              },
              {
                "key": "Application",
                "value": "{{application}}",
                "type": "text"
              },
              {
                "key": "CurrentCompany",
                "value": "{{currentCompany}}",
                "type": "text"
              },
              {
                "key": "AccessGroup",
                "value": "{{accessGroup}}",
                "type": "text"
              },
              {
                "key": "EconomicGroup",
                "value": "{{economicGroup}}",
                "type": "text"
              },
              {
                "key": "SessionID",
                "value": "{{sessionId}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{serviceUrl}}/LinxFrameworkAutorizacao/RevokeMfaSecret?tableOrigin={{tableOrigin}}&idGpecon={{idGpecon}}&uidUsuario={{uidUsuario}}&idUserMfa={{idUserMfa}}",
              "host": [
                "{{serviceUrl}}"
              ],
              "path": [
                "LinxFrameworkAutorizacao",
                "RevokeMfaSecret"
              ],
              "query": [
                {
                  "key": "tableOrigin",
                  "value": "{{tableOrigin}}"
                },
                {
                  "key": "idGpecon",
                  "value": "{{idGpecon}}"
                },
                {
                  "key": "uidUsuario",
                  "value": "{{uidUsuario}}"
                },
                {
                  "key": "idUserMfa",
                  "value": "{{idUserMfa}}",
                  "description": "Opcional se uidUsuario estiver preenchido"
                }
              ]
            },
            "description": "Revoga o ACCESS_SECRET MFA do usuário.\n\nEfeitos:\n- UPDATE TCS_USUARIO_MFA: ATIVO=0, ACCESS_SECRET=NULL, limpa lockout TOTP\n- DELETE TCS_USUARIO_MFA_DISPOSITIVO\n- Auditoria tipo R / canal MFA-Admin\n\nNão emite ticket MFA. Não altera senha nem vínculo SSO.\n\nMétodo: GET (não POST)."
          },
          "response": [
            {
              "name": "Exemplo — sucesso",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"Success\": true,\n  \"Message\": \"MFA revogado. O usuário cadastrará um novo QR no próximo acesso.\",\n  \"Ticket\": null,\n  \"TicketExpiresUtc\": null,\n  \"MfaLocked\": false\n}"
            },
            {
              "name": "Exemplo — usuário não resolvido",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"Success\": false,\n  \"Message\": \"Usuário MFA não informado.\",\n  \"Ticket\": null,\n  \"TicketExpiresUtc\": null,\n  \"MfaLocked\": false\n}"
            }
          ]
        },
        {
          "name": "3. GetMfaStatus (depois)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "AuthorizationToken",
                "value": "{{authorizationToken}}",
                "type": "text"
              },
              {
                "key": "CurrentUser",
                "value": "{{currentUser}}",
                "type": "text"
              },
              {
                "key": "Environment",
                "value": "{{environment}}",
                "type": "text"
              },
              {
                "key": "Application",
                "value": "{{application}}",
                "type": "text"
              },
              {
                "key": "CurrentCompany",
                "value": "{{currentCompany}}",
                "type": "text"
              },
              {
                "key": "AccessGroup",
                "value": "{{accessGroup}}",
                "type": "text"
              },
              {
                "key": "EconomicGroup",
                "value": "{{economicGroup}}",
                "type": "text"
              },
              {
                "key": "SessionID",
                "value": "{{sessionId}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{serviceUrl}}/LinxFrameworkAutorizacao/GetMfaStatus?tableOrigin={{tableOrigin}}&idGpecon={{idGpecon}}&uidUsuario={{uidUsuario}}&idUserMfa={{idUserMfa}}",
              "host": [
                "{{serviceUrl}}"
              ],
              "path": [
                "LinxFrameworkAutorizacao",
                "GetMfaStatus"
              ],
              "query": [
                {
                  "key": "tableOrigin",
                  "value": "{{tableOrigin}}"
                },
                {
                  "key": "idGpecon",
                  "value": "{{idGpecon}}"
                },
                {
                  "key": "uidUsuario",
                  "value": "{{uidUsuario}}"
                },
                {
                  "key": "idUserMfa",
                  "value": "{{idUserMfa}}"
                }
              ]
            },
            "description": "Confirmação pós-revogação: espere `Enrolled=false` e `CanRevoke=false`. `RequiresMfa` pode continuar `true` se a política da empresa/usuário ainda exigir MFA (próximo login = novo QR)."
          },
          "response": [
            {
              "name": "Exemplo — após revogar",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"TableOrigin\": \"UX\",\n  \"IdGpecon\": 123,\n  \"IdUserMfa\": 456,\n  \"Enrolled\": false,\n  \"CanRevoke\": false,\n  \"RequiresMfa\": true,\n  \"MfaLocked\": false\n}"
            }
          ]
        }
      ]
    }
